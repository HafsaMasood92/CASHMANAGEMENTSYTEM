
@using Microsoft.AspNetCore.Http

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentTab = Context.Request.Query["tab"].ToString();

    var userRole = Context.Session.GetString("UserRole") ?? "";
    var userEmail = Context.Session.GetString("UserEmail") ?? "admin@edutech.com";
    var sessionOrgName = Context.Session.GetString("OrganizationName");

    var userName = userRole switch
    {
        "Super Admin" => "Super Admin",
        "Organization Admin" or "Organization Owner" => "Organization Admin",
        "Accountant" or "School Accountant" or "Multi-Unit Accountant" => "Accountant",
        "User" or "Single Unit User" => "User",
        _ => "Staff User"
    };

    bool isSuperAdmin = userRole == "Super Admin";
    bool isOwner = userRole == "Organization Admin" || userRole == "Organization Owner";
    bool isAccountant = userRole == "Accountant"
                     || userRole == "School Accountant"
                     || userRole == "Multi-Unit Accountant";
    bool isRegularUser = userRole == "User" || userRole == "Single Unit User";

    var orgName = !string.IsNullOrWhiteSpace(sessionOrgName) ? sessionOrgName : (isSuperAdmin ? "Platform Administration" : "Organization");

    bool IsActive(string name, string? act = null) =>
        controller == name && (act == null || action == act);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @(isSuperAdmin ? "Cash Management System" : orgName)</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="appPage">
        <aside class="sidebar">
            <a asp-controller="Home" asp-action="Index" class="brand sidebar-brand">
                <span class="brand-mark">@(isSuperAdmin ? "CMS" : (string.IsNullOrWhiteSpace(orgName) ? "O" : orgName[..1].ToUpper()))</span>
                <span>@(isSuperAdmin ? "Cash Management" : orgName)</span>
            </a>

            @if (isSuperAdmin)
            {
                <div class="org-label">
                    <small>SYSTEM CONSOLE</small>
                    <strong>Platform Administration</strong>
                </div>

                <div class="nav-heading">Platform</div>
                <nav id="mainNav">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-item @(IsActive("Home") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        </span>
                        <span class="nav-text">Dashboard</span>
                    </a>

                    <a href="/Users/Index?tab=organizations"
                       class="nav-item @(controller == "Users" && (currentTab == "organizations" || string.IsNullOrEmpty(currentTab)) ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>
                        </span>
                        <span class="nav-text">Organizations</span>
                    </a>

                    <a href="/Users/Index?tab=admins"
                       class="nav-item @(controller == "Users" && currentTab == "admins" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                        </span>
                        <span class="nav-text">Organization Admins</span>
                    </a>
                </nav>
            }
            else if (isOwner)
            {
                <div class="org-label">
                    <small>ORGANIZATION</small>
                    <strong>@orgName</strong>
                </div>

                <div class="nav-heading">Management</div>
                <nav id="mainNav">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-item @(IsActive("Home") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        </span>
                        <span class="nav-text">Dashboard</span>
                    </a>

                    <a asp-controller="Units" asp-action="Index"
                       class="nav-item @(IsActive("Units") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
                        </span>
                        <span class="nav-text">Organizational Units</span>
                    </a>

                    <a asp-controller="Transactions" asp-action="Revenue"
                       class="nav-item @(IsActive("Transactions", "Revenue") || IsActive("Transactions", "Expenses") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                        </span>
                        <span class="nav-text">Transactions</span>
                    </a>

                    <a asp-controller="BankAccounts" asp-action="Index"
                       class="nav-item @(IsActive("BankAccounts") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                        </span>
                        <span class="nav-text">Bank Accounts</span>
                    </a>

                    <a asp-controller="Bills" asp-action="Index"
                       class="nav-item @(IsActive("Bills") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </span>
                        <span class="nav-text">Bills &amp; Payments</span>
                    </a>

                    <a asp-controller="Reports" asp-action="Index"
                       class="nav-item @(IsActive("Reports") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                        </span>
                        <span class="nav-text">Reports</span>
                    </a>

                    <a asp-controller="Notifications" asp-action="Index"
                       class="nav-item @(IsActive("Notifications") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        </span>
                        <span class="nav-text">Notifications</span>
                    </a>

                    <a asp-controller="Settings" asp-action="Index"
                       class="nav-item @(IsActive("Settings") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                        </span>
                        <span class="nav-text">Settings</span>
                    </a>

                    <a asp-controller="Users" asp-action="Index"
                       class="nav-item @(IsActive("Users") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </span>
                        <span class="nav-text">User Management</span>
                    </a>
                </nav>
            }
            else if (isAccountant)
            {
                <div class="org-label">
                    <small>OPERATIONAL UNIT</small>
                    <strong>Finance Desk</strong>
                </div>

                <div class="nav-heading">Operations</div>
                <nav id="mainNav">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-item @(IsActive("Home") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        </span>
                        <span class="nav-text">Dashboard</span>
                    </a>

                    <a asp-controller="Transactions" asp-action="Revenue"
                       class="nav-item @(IsActive("Transactions", "Revenue") || IsActive("Transactions", "Expenses") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                        </span>
                        <span class="nav-text">Transactions</span>
                    </a>

                    <a asp-controller="Bills" asp-action="Index"
                       class="nav-item @(IsActive("Bills") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </span>
                        <span class="nav-text">Bills &amp; Payments</span>
                    </a>

                    <a asp-controller="Reports" asp-action="Index"
                       class="nav-item @(IsActive("Reports") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                        </span>
                        <span class="nav-text">Reports</span>
                    </a>

                    <a asp-controller="Notifications" asp-action="Index"
                       class="nav-item @(IsActive("Notifications") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        </span>
                        <span class="nav-text">Notifications</span>
                    </a>
                </nav>
            }
            else
            {
                <div class="org-label">
                    <small>USER CONSOLE</small>
                    <strong>Staff Access</strong>
                </div>

                <div class="nav-heading">Workspace</div>
                <nav id="mainNav">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-item @(IsActive("Home") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        </span>
                        <span class="nav-text">Dashboard</span>
                    </a>

                    <a asp-controller="Notifications" asp-action="Index"
                       class="nav-item @(IsActive("Notifications") ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        </span>
                        <span class="nav-text">Notifications</span>
                    </a>
                </nav>
            }

            <div class="sidebar-bottom">
                <div class="user-mini">
                    <div class="avatar">
                        @(userName.Length > 0 ? userName[..1].ToUpper() : "U")
                    </div>
                    <div class="user-details" style="overflow:hidden;">
                        <strong style="white-space:nowrap;text-overflow:ellipsis;overflow:hidden;">@userName</strong>
                        <small style="white-space:nowrap;text-overflow:ellipsis;overflow:hidden;display:block;">@userEmail</small>
                    </div>
                </div>

                <a asp-controller="Account" asp-action="Logout" class="nav-item text-danger mt-2" style="padding:8px 12px;">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    </span>
                    <span class="nav-text">Sign Out</span>
                </a>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <nav aria-label="breadcrumb" class="d-flex align-items-center gap-2 text-muted" style="font-size:13px;">
                    <span class="text-secondary">@(isSuperAdmin ? "Cash Management System" : orgName)</span>
                    <span class="opacity-50">/</span>
                    <span class="text-dark fw-semibold">@ViewData["Title"]</span>
                </nav>

                <div class="top-actions">
                    <a asp-controller="Notifications" asp-action="Index"
                       class="icon-btn position-relative" title="Notifications"
                       style="text-decoration:none;display:inline-flex;align-items:center;justify-content:center;position:relative;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span id="navUnreadBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                              style="display:none;font-size:10px;padding:2px 5px;transform:translate(30%, -30%);">
                            0
                        </span>
                    </a>

                    <div class="top-user">
                        <div class="avatar">
                            @(userName.Length > 0 ? userName[..1].ToUpper() : "U")
                        </div>
                        <div class="user-details">
                            <strong>@userName</strong>
                            <small>@userRole</small>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content">
                @if (TempData["NoticeMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius:10px; background:#eff6ff; color:#1e40af; border-left:4px solid #3b82f6 !important;">
                        <div class="d-flex align-items-center gap-2">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            <span>@TempData["NoticeMessage"]</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius:10px; background:#fef2f2; color:#991b1b; border-left:4px solid #ef4444 !important;">
                        <div class="d-flex align-items-center gap-2">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            <span>@TempData["ErrorMessage"]</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius:10px; background:#f0fdf4; color:#166534; border-left:4px solid #22c55e !important;">
                        <div class="d-flex align-items-center gap-2">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            <span>@TempData["SuccessMessage"]</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (async function checkUnreadNotifications() {
            try {
                const res = await fetch("/api/notifications?status=unread");
                if (res.ok) {
                    const data = await res.json();
                    const count = data.unreadCount || 0;
                    const badge = document.getElementById("navUnreadBadge");
                    if (badge) {
                        if (count > 0) {
                            badge.textContent = count > 99 ? "99+" : count;
                            badge.style.display = "inline-block";
                        } else {
                            badge.style.display = "none";
                        }
                    }
                }
            } catch (e) {}
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

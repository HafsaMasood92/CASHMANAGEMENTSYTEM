
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Organizational Units";
    var userRole = Context.Session.GetString("UserRole") ?? "";
    var canAddUnit = userRole == "Super Admin" || userRole == "Organization Admin" || userRole == "Organization Owner";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert" style="border-radius:10px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header">
    <div>
        <h1>Organizational Units</h1>
        <p>Manage units and view their financial performance.</p>
    </div>

    @if (canAddUnit)
    {
        <button type="button" class="btn btn-primary" onclick="openUnitForm()">
            + Add Unit
        </button>
    }
</div>

<section class="summary-grid">
    <article class="summary-card">
        <div class="summary-card-top">
            <span>Total Units</span>
            <span class="summary-icon" style="background:#eff6ff;color:#2563eb;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            </span>
        </div>
        <h2 id="totalUnits">0</h2>
        <p>Registered organizational units</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Active Units</span>
            <span class="summary-icon" style="background:#ecfdf5;color:#059669;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </span>
        </div>
        <h2 id="activeUnits">0</h2>
        <p>Operational units</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Inactive Units</span>
            <span class="summary-icon" style="background:#f1f5f9;color:#64748b;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
            </span>
        </div>
        <h2 id="inactiveUnits">0</h2>
        <p>Archived or disabled</p>
    </article>
</section>

<section class="panel">

    <div class="transaction-toolbar">
        <input id="unitSearch" type="search" class="form-control"
               placeholder="Search units..." />

        <select id="unitStatusFilter" class="form-select">
            <option value="all">All statuses</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Unit name</th>
                    <th>Category</th>
                    <th>Financial tracking</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="unitRows"></tbody>
        </table>
    </div>
</section>

<div id="unitModal" class="transaction-modal" hidden>
    <form id="unitForm" class="transaction-form">
        @Html.AntiForgeryToken()
        <div class="form-heading">
            <div>
                <h2>Add Organizational Unit</h2>
                <p>Create a unit for financial reporting.</p>
            </div>
            <button type="button" class="close-button"
                    aria-label="Close form" onclick="closeUnitForm()">×</button>
        </div>

        <label for="unitName">Unit name</label>
        <input id="unitName" name="name" class="form-control" required maxlength="100"
               placeholder="Enter unit name" />

        <label for="unitCategory">Category</label>
        <select id="unitCategory" name="category" class="form-select" required>
            <option value="School">School</option>
            <option value="College">College</option>
            <option value="BS Program">BS Program</option>
            <option value="Training Center">Training Center</option>
            <option value="Evening Academy">Evening Academy</option>
            <option value="Other">Other</option>
        </select>

        <div class="form-actions">
            <button type="button" class="btn btn-outline-secondary"
                    onclick="closeUnitForm()">Cancel</button>
            <button type="submit" class="btn btn-primary" id="saveUnitBtn">Save Unit</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let units = [];

        function escapeUnitHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            })[character]);
        }

        function openUnitForm() {
            document.getElementById("unitModal").hidden = false;
            document.getElementById("unitName").focus();
        }

        function closeUnitForm() {
            document.getElementById("unitModal").hidden = true;
        }

        function openUnitDashboard(id) {
            const unit = units.find(item => item.id === id);
            if (!unit) return;

            if (!unit.active) {
                alert("This unit is inactive. Activate it before opening its dashboard.");
                return;
            }

            const url = "/Units/Dashboard?name=" + encodeURIComponent(unit.name);
            window.location.href = url;
        }

        async function fetchUnitsFromDb() {
            try {
                const response = await fetch("/api/units");
                if (!response.ok) throw new Error("Failed to load units");
                const data = await response.json();
                units = data.items || [];
                renderUnits();
            } catch (err) {
                console.error("Error loading units:", err);
            }
        }

        document.getElementById("unitForm").addEventListener("submit", async function (event) {
            event.preventDefault();

            const name = document.getElementById("unitName").value.trim();
            if (!name) return;

            const btn = document.getElementById("saveUnitBtn");
            btn.disabled = true;
            btn.textContent = "Saving...";

            const formData = new FormData(this);

            try {
                const response = await fetch("/api/units", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    this.reset();
                    closeUnitForm();
                    await fetchUnitsFromDb();
                } else {
                    alert(result.message || "Failed to save unit.");
                }
            } catch (err) {
                alert("Network error while saving unit.");
            } finally {
                btn.disabled = false;
                btn.textContent = "Save Unit";
            }
        });

        async function toggleUnitStatus(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
            const formData = new FormData();
            formData.append("id", id);
            formData.append("__RequestVerificationToken", token);

            try {
                const response = await fetch("/api/units/toggle-status", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    await fetchUnitsFromDb();
                }
            } catch (err) {
                alert("Error toggling unit status.");
            }
        }

        function renderUnits() {
            const search = document.getElementById("unitSearch")
                .value.trim().toLowerCase();

            const statusFilter = document.getElementById("unitStatusFilter").value;

            const filtered = units.filter(unit => {
                const status = unit.active ? "Active" : "Inactive";

                return unit.name.toLowerCase().includes(search) &&
                    (statusFilter === "all" || status === statusFilter);
            });

            document.getElementById("unitRows").innerHTML = filtered.length
                ? filtered.map(unit => `
                    <tr>
                        <td>
                            <strong>${escapeUnitHtml(unit.name)}</strong>
                        </td>
                        <td>${escapeUnitHtml(unit.category)}</td>
                        <td>
                            <span class="status-badge status-paid">Enabled</span>
                        </td>
                        <td>
                            <span class="status-badge ${
                                unit.active ? "status-paid" : "status-pending"
                            }">
                                ${unit.active ? "Active" : "Inactive"}
                            </span>
                        </td>
                        <td>
                            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                <button type="button"
                                    class="btn btn-sm btn-primary"
                                    onclick="openUnitDashboard(${unit.id})">
                                    View Dashboard →
                                </button>

                                <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    onclick="toggleUnitStatus(${unit.id})">
                                    ${unit.active ? "Deactivate" : "Activate"}
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join("")
                : `<tr>
                    <td colspan="5" class="text-center py-5">
                        No units match your search.
                    </td>
                   </tr>`;

            document.getElementById("totalUnits").textContent = units.length;

            document.getElementById("activeUnits").textContent =
                units.filter(unit => unit.active).length;

            document.getElementById("inactiveUnits").textContent =
                units.filter(unit => !unit.active).length;
        }

        ["unitSearch", "unitStatusFilter"].forEach(id => {
            const element = document.getElementById(id);
            element.addEventListener("input", renderUnits);
            element.addEventListener("change", renderUnits);
        });

        document.getElementById("unitModal").addEventListener("click", function (event) {
            if (event.target === this) closeUnitForm();
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") closeUnitForm();
        });

        fetchUnitsFromDb();
    </script>
}

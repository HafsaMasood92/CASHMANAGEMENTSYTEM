
@{
    ViewData["Title"] = "Unit Dashboard";
}

<style>
    .unit-dashboard { display: flex; flex-direction: column; gap: 22px; }
    .unit-dashboard .unit-heading {
        display: flex; justify-content: space-between; align-items: center;
        gap: 16px; flex-wrap: wrap;
    }
    .unit-dashboard .eyebrow {
        font-size: 11px; font-weight: 700; letter-spacing: 1.5px;
        color: #64748b; margin-bottom: 7px;
    }
    .unit-dashboard h1 { margin: 0 0 7px; font-size: 28px; font-weight: 750; }
    .unit-dashboard .subtext { margin: 0; color: #64748b; font-size: 14px; }
    .unit-dashboard .unit-label {
        display: inline-flex; align-items: center; gap: 8px;
        background: #eff6ff; color: #1d4ed8; padding: 9px 13px;
        border-radius: 9px; font-size: 12px; font-weight: 700;
    }
    .unit-dashboard .unit-metrics {
        display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px;
    }
    .unit-dashboard .metric {
        background: white; border: 1px solid #e8edf4; border-radius: 14px;
        padding: 20px; min-width: 0; transition: transform .2s, box-shadow .2s;
    }
    .unit-dashboard .metric:hover {
        transform: translateY(-3px);
        box-shadow: 0 9px 24px rgba(15, 23, 42, .06);
    }
    .unit-dashboard .metric-top {
        display: flex; justify-content: space-between; gap: 8px;
        align-items: center; color: #64748b; font-size: 12px; font-weight: 600;
    }
    .unit-dashboard .metric-icon {
        width: 36px; height: 36px; display: grid; place-items: center;
        border-radius: 10px; font-size: 18px;
    }
    .unit-dashboard .metric-value {
        margin: 18px 0 7px; font-size: clamp(20px, 2vw, 27px);
        font-weight: 750; color: #172033; overflow-wrap: anywhere;
    }
    .unit-dashboard .metric-note { margin: 0; color: #94a3b8; font-size: 11px; }
    .unit-dashboard .dashboard-columns {
        display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
        gap: 18px;
    }
    .unit-dashboard .dash-panel {
        background: white; border: 1px solid #e8edf4; border-radius: 14px;
        padding: 22px; min-width: 0;
    }
    .unit-dashboard .panel-heading {
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 12px; margin-bottom: 20px;
    }
    .unit-dashboard .panel-heading h3 { margin: 0 0 6px; font-size: 16px; font-weight: 700; }
    .unit-dashboard .panel-heading p { margin: 0; font-size: 12px; color: #94a3b8; }
    .unit-dashboard .period-select {
        border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px;
        font-size: 12px; background: white; color: #334155; max-width: 140px;
    }
    .unit-dashboard .chart {
        height: 205px; display: flex; align-items: stretch;
        gap: 12px; padding-top: 12px;
    }
    .unit-dashboard .chart-column {
        flex: 1; min-width: 0; display: flex; flex-direction: column;
        justify-content: flex-end; align-items: center; gap: 9px;
    }
    .unit-dashboard .bar-area {
        height: 165px; width: 100%; display: flex; align-items: flex-end;
        justify-content: center; gap: 5px; border-bottom: 1px solid #e9eef5;
        background: repeating-linear-gradient(to bottom, transparent 0, transparent 39px, #f1f5f9 40px);
    }
    .unit-dashboard .bar {
        width: min(27px, 42%); min-height: 3px; border-radius: 5px 5px 0 0;
        transition: height .3s ease;
    }
    .unit-dashboard .bar-revenue { background: #2563eb; }
    .unit-dashboard .bar-expense { background: #cbd5e1; }
    .unit-dashboard .chart-month { color: #94a3b8; font-size: 10px; }
    .unit-dashboard .chart-legend {
        display: flex; flex-wrap: wrap; gap: 16px; margin-top: 18px;
        font-size: 11px; color: #64748b;
    }
    .unit-dashboard .legend-dot {
        display: inline-block; width: 8px; height: 8px;
        border-radius: 3px; margin-right: 6px;
    }
    .unit-dashboard .summary-list { display: flex; flex-direction: column; }
    .unit-dashboard .summary-row {
        display: flex; justify-content: space-between; align-items: center;
        gap: 12px; padding: 15px 0; border-bottom: 1px solid #f1f5f9;
        font-size: 13px;
    }
    .unit-dashboard .summary-row:last-child { border-bottom: 0; }
    .unit-dashboard .summary-name { color: #64748b; }
    .unit-dashboard .summary-amount { font-weight: 700; color: #172033; text-align: right; }
    .unit-dashboard .summary-amount.positive { color: #059669; }
    .unit-dashboard .summary-amount.negative { color: #dc2626; }
    .unit-dashboard .demo-notice {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 13px 15px; border-radius: 10px; background: #fffbeb;
        border: 1px solid #fde68a; color: #92400e; font-size: 12px;
    }
    .unit-dashboard .table-responsive { overflow-x: auto; }
    .unit-dashboard .unit-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .unit-dashboard .unit-table th {
        text-align: left; color: #94a3b8; font-weight: 600;
        padding: 12px 10px; border-bottom: 1px solid #e8edf4; white-space: nowrap;
    }
    .unit-dashboard .unit-table td {
        padding: 14px 10px; border-bottom: 1px solid #f1f5f9;
        color: #475569; white-space: nowrap;
    }
    .unit-dashboard .unit-table tr:last-child td { border-bottom: 0; }
    .unit-dashboard .mini-status {
        display: inline-block; padding: 5px 8px; border-radius: 6px;
        background: #fef3c7; color: #92400e; font-size: 10px; font-weight: 700;
    }
    .unit-dashboard .back-link {
        display: inline-flex; align-items: center; gap: 7px;
        color: #475569; text-decoration: none; font-size: 12px; font-weight: 600;
        margin-bottom: 20px;
    }
    .unit-dashboard .back-link:hover { color: #2563eb; }
    @@media (max-width: 1050px) {
        .unit-dashboard .unit-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .unit-dashboard .dashboard-columns { grid-template-columns: 1fr; }
    }
    @@media (max-width: 560px) {
        .unit-dashboard .unit-metrics { grid-template-columns: 1fr; }
        .unit-dashboard .dash-panel { padding: 16px; }
        .unit-dashboard h1 { font-size: 23px; }
        .unit-dashboard .chart { gap: 5px; }
    }
</style>

@{
    var allowedUnits = (ViewData["AllowedUnits"] as List<string>) ?? new List<string>();
    var currentUnit = ViewData["UnitName"]?.ToString() ?? "";
}

<div class="unit-dashboard">
    <div>
        <a asp-controller="Units" asp-action="Index" class="back-link">
            ← Back to Organizational Units
        </a>

        <div class="unit-heading">
            <div>
                <h1 id="unitTitle">@currentUnit Dashboard</h1>
                <p class="subtext">Financial performance for this unit.</p>
            </div>
            @if (allowedUnits.Count > 1)
            {
                <div class="d-flex align-items-center gap-2">
                    <label for="unitSwitcher" class="small text-muted fw-semibold mb-0">Switch Unit:</label>
                    <select id="unitSwitcher" class="form-select form-select-sm" style="min-width:160px;border-radius:8px;" onchange="window.location.href='/Units/Dashboard?name=' + encodeURIComponent(this.value)">
                        @foreach (var u in allowedUnits)
                        {
                            if (u.Equals(currentUnit, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@u" selected>@u</option>
                            }
                            else
                            {
                                <option value="@u">@u</option>
                            }
                        }
                    </select>
                </div>
            }
        </div>
    </div>

    <section class="unit-metrics">
        <article class="metric">
            <div class="metric-top">
                <span>Period Revenue</span>
                <span class="metric-icon" style="background:#eff6ff;color:#2563eb;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>
                </span>
            </div>
            <div class="metric-value" id="periodRevenue">Rs. 0</div>
            <p class="metric-note">Revenue in selected period</p>
        </article>

        <article class="metric">
            <div class="metric-top">
                <span>Period Expenses</span>
                <span class="metric-icon" style="background:#fff7ed;color:#ea580c;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
            </div>
            <div class="metric-value" id="periodExpenses">Rs. 0</div>
            <p class="metric-note">Expenses in selected period</p>
        </article>

        <article class="metric">
            <div class="metric-top">
                <span>All-Time Net Balance</span>
                <span class="metric-icon" style="background:#ecfdf5;color:#059669;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                </span>
            </div>
            <div class="metric-value" id="netBalance">Rs. 0</div>
            <p class="metric-note">Cumulative net cash flow</p>
        </article>

        <article class="metric">
            <div class="metric-top">
                <span>Outstanding Bills</span>
                <span class="metric-icon" style="background:#fef2f2;color:#dc2626;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </span>
            </div>
            <div class="metric-value" id="outstandingBills">Rs. 0</div>
            <p class="metric-note">Unpaid vendor obligations</p>
        </article>
    </section>

    <section class="dashboard-columns">
        <article class="dash-panel">
            <div class="panel-heading">
                <div>
                    <h3>Cash Flow Overview</h3>
                    <p>Monthly revenue compared with expenses</p>
                </div>
                <select id="reportPeriod" class="period-select" aria-label="Reporting period">
                    <option value="month">This Month</option>
                    <option value="lastMonth">Last Month</option>
                    <option value="year">This Year</option>
                    <option value="all">All Time</option>
                </select>
            </div>

            <div id="cashFlowChart" class="chart"></div>

            <div class="chart-legend">
                <span><i class="legend-dot" style="background:#2563eb;"></i>Revenue</span>
                <span><i class="legend-dot" style="background:#cbd5e1;"></i>Expenses</span>
            </div>
        </article>

        <article class="dash-panel">
            <div class="panel-heading">
                <div>
                    <h3>Financial Summary</h3>
                    <p>Current balance breakdown</p>
                </div>
            </div>

            <div class="summary-list">
                <div class="summary-row">
                    <span class="summary-name">Cash on Hand</span>
                    <span class="summary-amount" id="cashOnHand">Rs. 0</span>
                </div>
                <div class="summary-row">
                    <span class="summary-name">Bank Balance</span>
                    <span class="summary-amount" id="bankBalance">Rs. 0</span>
                </div>
                <div class="summary-row">
                    <span class="summary-name">Outstanding Bills</span>
                    <span class="summary-amount" id="summaryOutstanding">Rs. 0</span>
                </div>
                <div class="summary-row">
                    <span class="summary-name">Net Balance</span>
                    <span class="summary-amount positive" id="summaryNet">Rs. 0</span>
                </div>
            </div>
        </article>
    </section>

    <section class="dash-panel">
        <div class="panel-heading">
            <div>
                <h3>Recent Financial Activity</h3>
                <p>Latest recorded entries for this unit</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="unit-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Account / Method</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody id="activityRows">
                    <tr><td colspan="5" style="text-align:center;padding:24px;color:#94a3b8;">Loading activity...</td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        function formatCurrency(amount) {
            return "Rs. " + Number(amount || 0).toLocaleString("en-PK");
        }

        function safeText(value) {
            return String(value || "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            })[character]);
        }

        let selectedUnitName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["UnitName"] ?? ""));

        async function loadUnitDashboard() {
            if (!selectedUnitName) {
                document.getElementById("unitTitle").textContent = "No Unit Selected";
                return;
            }
            const period = document.getElementById("reportPeriod").value;
            document.getElementById("unitTitle").textContent = selectedUnitName + " Dashboard";

            try {
                const res = await fetch(`/api/units/dashboard-data?name=${encodeURIComponent(selectedUnitName)}&period=${period}`);
                if (res.status === 403) {
                    alert("Access denied. You do not have permission to view metrics for this unit.");
                    window.location.href = "/Units/Index";
                    return;
                }
                if (!res.ok) throw new Error("Failed to load unit dashboard data");
                const data = await res.json();

                document.getElementById("periodRevenue").textContent = formatCurrency(data.periodRevenue);
                document.getElementById("periodExpenses").textContent = formatCurrency(data.periodExpenses);
                document.getElementById("netBalance").textContent = formatCurrency(data.allTimeNet);
                document.getElementById("outstandingBills").textContent = formatCurrency(data.outstandingBills);

                document.getElementById("cashOnHand").textContent = formatCurrency(data.cashOnHand);
                document.getElementById("bankBalance").textContent = formatCurrency(data.bankBalance);
                document.getElementById("summaryOutstanding").textContent = formatCurrency(data.outstandingBills);
                
                const summaryNet = document.getElementById("summaryNet");
                summaryNet.textContent = formatCurrency(data.allTimeNet);
                if (data.allTimeNet >= 0) {
                    summaryNet.className = "summary-amount positive";
                } else {
                    summaryNet.className = "summary-amount negative";
                }

                // Render Chart
                const months = data.months || [];
                const maxVal = Math.max(1, ...months.map(m => Math.max(Number(m.revenue) || 0, Number(m.expenses) || 0)));

                document.getElementById("cashFlowChart").innerHTML = months.map(m => {
                    const rev = Number(m.revenue) || 0;
                    const exp = Number(m.expenses) || 0;
                    const revenueHeight = Math.max(3, (rev / maxVal) * 100);
                    const expenseHeight = Math.max(3, (exp / maxVal) * 100);

                    return `
                        <div class="chart-column">
                            <div class="bar-area">
                                <div class="bar bar-revenue"
                                    style="height:${revenueHeight}%"
                                    title="Revenue: ${formatCurrency(rev)}"></div>
                                <div class="bar bar-expense"
                                    style="height:${expenseHeight}%"
                                    title="Expenses: ${formatCurrency(exp)}"></div>
                            </div>
                            <span class="chart-month">${safeText(m.label)}</span>
                        </div>
                    `;
                }).join("");

                // Render Recent Activities
                const activities = data.recentActivities || [];
                const activityRows = document.getElementById("activityRows");
                if (activities.length === 0) {
                    activityRows.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:24px;color:#94a3b8;">No recent transactions for ${safeText(selectedUnitName)}.</td></tr>`;
                } else {
                    activityRows.innerHTML = activities.map(act => `
                        <tr>
                            <td><strong>${safeText(act.description)}</strong></td>
                            <td>
                                <span style="display:inline-block;padding:3px 8px;border-radius:4px;font-size:11px;font-weight:600;background:${act.type === 'Revenue' ? '#ecfdf5' : '#fef2f2'};color:${act.type === 'Revenue' ? '#059669' : '#dc2626'}">
                                    ${safeText(act.type)}
                                </span>
                            </td>
                            <td>${safeText(act.date)}</td>
                            <td>${safeText(act.account)}</td>
                            <td style="font-weight:700;color:${act.type === 'Revenue' ? '#059669' : '#dc2626'};">
                                ${act.type === 'Revenue' ? '+' : '−'}${formatCurrency(act.amount)}
                            </td>
                        </tr>
                    `).join("");
                }
            } catch (err) {
                console.error("Dashboard load error:", err);
            }
        }

        document.getElementById("reportPeriod").addEventListener("change", loadUnitDashboard);
        loadUnitDashboard();
    </script>
}

@using Microsoft.AspNetCore.Http

@{
    Layout = null;
    ViewData["Title"] = "Sign In | Edutech Cash Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In | Edutech Cash Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy-dark: #0f172a;
            --navy: #1e293b;
            --navy-light: #334155;
            --blue: #2563eb;
            --blue-hover: #1d4ed8;
            --blue-light: #eff6ff;
            --blue-border: #dbeafe;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --bg-page: #f8fafc;
            --bg-card: #ffffff;
            --danger: #dc2626;
            --danger-bg: #fef2f2;
            --danger-border: #fecaca;
        }

        html, body {
            height: 100vh;
            width: 100vw;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: var(--bg-page);
            color: var(--text-primary);
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        html::-webkit-scrollbar,
        body::-webkit-scrollbar {
            display: none;
            width: 0;
            height: 0;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(10px, 2vh, 20px) clamp(12px, 2.5vw, 24px);
        }

        .login-shell {
            width: 100%;
            max-width: 960px;
            max-height: calc(100vh - clamp(16px, 3.5vh, 36px));
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.08), 0 10px 20px -8px rgba(15, 23, 42, 0.04);
        }

        /* --- Left Brand Panel --- */
        .brand-panel {
            background: linear-gradient(155deg, #0f172a 0%, #1e293b 60%, #1e3a8a 100%);
            color: #ffffff;
            padding: clamp(24px, 4vh, 40px) clamp(22px, 3.2vw, 36px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            top: -120px;
            right: -120px;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.22) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .brand-panel::after {
            content: "";
            position: absolute;
            bottom: -90px;
            left: -90px;
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.14) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 11px;
            position: relative;
            z-index: 1;
        }

        .brand-logo {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
            flex-shrink: 0;
        }

        .brand-title {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -0.3px;
            line-height: 1.25;
            color: #ffffff;
        }

        .brand-title span {
            display: block;
            font-size: 12px;
            font-weight: 400;
            color: #94a3b8;
            letter-spacing: normal;
        }

        .brand-content {
            position: relative;
            z-index: 1;
            margin: clamp(14px, 2.4vh, 26px) 0;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 11px;
            border-radius: 20px;
            background: rgba(37, 99, 235, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #93c5fd;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: clamp(10px, 1.6vh, 16px);
        }

        .brand-headline {
            font-size: clamp(21px, 2.3vw, 26px);
            font-weight: 700;
            line-height: 1.25;
            letter-spacing: -0.6px;
            color: #ffffff;
            margin-bottom: clamp(8px, 1.2vh, 12px);
        }

        .brand-desc {
            font-size: clamp(12px, 1.1vw, 13px);
            line-height: 1.55;
            color: #cbd5e1;
            margin-bottom: clamp(16px, 2.2vh, 22px);
            max-width: 360px;
        }

        .feature-list {
            display: flex;
            flex-direction: column;
            gap: clamp(8px, 1.3vh, 12px);
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: clamp(11.5px, 1.05vw, 12.5px);
            font-weight: 500;
            color: #e2e8f0;
        }

        .feature-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.25);
            border: 1px solid rgba(59, 130, 246, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #60a5fa;
            flex-shrink: 0;
        }

        .brand-footer {
            font-size: 11.5px;
            color: #64748b;
            position: relative;
            z-index: 1;
        }

        /* --- Right Form Panel --- */
        .form-panel {
            padding: clamp(24px, 4vh, 40px) clamp(22px, 3.2vw, 36px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #ffffff;
            overflow-y: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .form-panel::-webkit-scrollbar {
            display: none;
            width: 0;
            height: 0;
        }

        .form-header {
            margin-bottom: clamp(14px, 2.2vh, 20px);
        }

        .form-header h1 {
            font-size: clamp(20px, 2.2vw, 23px);
            font-weight: 700;
            letter-spacing: -0.5px;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .form-header p {
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.45;
        }

        .alert-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: var(--danger-bg);
            border: 1px solid var(--danger-border);
            color: var(--danger);
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 500;
            line-height: 1.45;
            margin-bottom: clamp(10px, 1.8vh, 16px);
        }

        .alert-error svg {
            flex-shrink: 0;
            margin-top: 1px;
        }

        .form-group {
            margin-bottom: clamp(10px, 1.8vh, 15px);
        }

        .form-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: var(--navy-light);
            margin-bottom: 5px;
        }

        .form-input {
            width: 100%;
            height: clamp(38px, 4.6vh, 42px);
            padding: 0 13px;
            border: 1px solid var(--border-color);
            border-radius: 9px;
            font-family: inherit;
            font-size: 13px;
            color: var(--text-primary);
            background: #ffffff;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input::placeholder {
            color: #94a3b8;
        }

        .form-input:hover {
            border-color: #cbd5e1;
        }

        .form-input:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-container .form-input {
            padding-right: 60px;
        }

        .btn-toggle-password {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--blue);
            font-family: inherit;
            font-size: 11.5px;
            font-weight: 600;
            cursor: pointer;
            padding: 5px 7px;
            border-radius: 5px;
            transition: background 0.15s, color 0.15s;
        }

        .btn-toggle-password:hover {
            background: var(--blue-light);
            color: var(--blue-hover);
        }

        .btn-signin {
            width: 100%;
            height: clamp(38px, 4.8vh, 43px);
            margin-top: clamp(4px, 1vh, 8px);
            margin-bottom: clamp(12px, 2vh, 18px);
            background: var(--blue);
            color: #ffffff;
            border: none;
            border-radius: 9px;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            transition: background 0.15s ease, transform 0.1s ease, box-shadow 0.15s ease;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.22);
        }

        .btn-signin:hover {
            background: var(--blue-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.30);
        }

        .btn-signin:active {
            transform: translateY(0);
        }

        .admin-notice {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: clamp(8px, 1.3vh, 11px) 12px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            font-size: 11.5px;
            color: var(--text-muted);
            line-height: 1.4;
            text-align: center;
        }

        .admin-notice svg {
            color: var(--blue);
            flex-shrink: 0;
        }

        .form-footer {
            margin-top: clamp(12px, 2vh, 18px);
            text-align: center;
            font-size: 11px;
            color: #94a3b8;
        }

        /* --- Responsive Styles --- */
        @@media (max-width: 820px) {
            html, body {
                overflow-y: auto;
            }

            .login-shell {
                grid-template-columns: 1fr;
                max-width: 440px;
                max-height: none;
            }

            .brand-panel {
                display: none;
            }

            .form-panel {
                padding: 30px 24px;
            }
        }
    </style>
</head>
<body>
    <main class="login-shell">
        <!-- Brand Information Panel -->
        <section class="brand-panel">
            <header class="brand-header">
                <div class="brand-logo" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                </div>
                <div class="brand-title">
                    Edutech
                    <span>Cash Management System</span>
                </div>
            </header>

            <div class="brand-content">
                <div class="brand-badge">Financial Workspace</div>
                <h2 class="brand-headline">Unified Institutional Cash Operations</h2>
                <p class="brand-desc">
                    Comprehensive ledger tracking, unit wise revenue management, real time bank reconciliation.
                </p>

                <div class="feature-list">
                    <div class="feature-item">
                        <span class="feature-icon" aria-hidden="true">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        <span>Institutional and multi unit ledger visibility</span>
                    </div>
                    <div class="feature-item">
                        <span class="feature-icon" aria-hidden="true">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        <span>Live bank accounts and fund transfers tracking</span>
                    </div>
                    <div class="feature-item">
                        <span class="feature-icon" aria-hidden="true">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        <span>Role governed audit logging and approvals</span>
                    </div>
                </div>
            </div>

            <footer class="brand-footer">
                Edutech Financial Platform
            </footer>
        </section>

        <!-- Login Form Panel -->
        <section class="form-panel">
            <div class="form-header">
                <h1>Sign In</h1>
                <p>Enter your credentials to access your financial workspace.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error" role="alert">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label" for="email">Email or Username</label>
                    <input id="email"
                           name="email"
                           type="text"
                           class="form-input"
                           placeholder="Enter your email or username"
                           autocomplete="username"
                           required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <div class="password-container">
                        <input id="password"
                               name="password"
                               type="password"
                               class="form-input"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button"
                                id="togglePasswordBtn"
                                class="btn-toggle-password"
                                onclick="togglePassword()"
                                aria-label="Toggle password visibility">
                            Show
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-signin" id="btnSignIn">
                    <span>Sign In</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </button>
            </form>

            <div class="admin-notice">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="16" x2="12" y2="12"/>
                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <span>Contact your administrator if you need login credentials.</span>
            </div>

            <footer class="form-footer">
                &copy; @DateTime.Now.Year Edutech &bull; Cash Management System
            </footer>
        </section>
    </main>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("password");
            const toggleButton = document.getElementById("togglePasswordBtn");
            if (!passwordInput || !toggleButton) return;

            const isPassword = passwordInput.type === "password";
            passwordInput.type = isPassword ? "text" : "password";
            toggleButton.textContent = isPassword ? "Hide" : "Show";
            toggleButton.setAttribute("aria-label", isPassword ? "Hide password" : "Show password");
        }
    </script>
</body>
</html>

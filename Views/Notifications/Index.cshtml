@{
    ViewData["Title"] = "Notifications";
    var userRole = Context.Session.GetString("UserRole") ?? "Super Admin";
}

<div class="page-header">
    <div>
        <h1>Notifications</h1>
        <p>Review activity logs and items requiring attention.</p>
    </div>

    <button type="button" class="btn btn-outline-secondary"
            onclick="markAllRead()">
        Mark all as read
    </button>
</div>

<section class="summary-grid">
    <article class="summary-card">
        <div class="summary-card-top">
            <span>Total Notifications</span>
            <span class="summary-icon" style="background:#eff6ff;color:#2563eb;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            </span>
        </div>
        <h2 id="totalNotifications">0</h2>
        <p>All recorded activities</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Unread</span>
            <span class="summary-icon" style="background:#ecfdf5;color:#059669;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
            </span>
        </div>
        <h2 id="unreadNotifications">0</h2>
        <p>Requires acknowledgement</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Action Required</span>
            <span class="summary-icon" style="background:#fffbeb;color:#d97706;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </span>
        </div>
        <h2 id="actionNotifications">0</h2>
        <p>Pending administrative decisions</p>
    </article>
</section>

<section class="panel">

    <div class="transaction-toolbar">
        <input id="notificationSearch" type="search"
               class="form-control"
               placeholder="Search notifications..." />

        <select id="notificationType" class="form-select">
            <option value="all">All types</option>
            <option value="Transaction">Financial activity</option>
            <option value="Approval">Deletion requests & Approvals</option>
            <option value="Deletion">Deletion requests</option>
            <option value="Bill">Bills & payments</option>
            <option value="System">System updates</option>
            <option value="Audit">Audit Logs</option>
        </select>

        <select id="notificationStatus" class="form-select">
            <option value="all">All notifications</option>
            <option value="unread">Unread only</option>
            <option value="read">Read only</option>
            <option value="action">Action required</option>
        </select>
    </div>

    <div id="notificationList"></div>

    <div id="emptyNotifications" hidden
         style="padding:40px 16px;text-align:center;">
        <h3>No notifications found</h3>
        <p>Try changing your search or filters.</p>
    </div>
</section>

@section Scripts {
    <script>
        let liveNotifications = [];
        const currentUserRole = '@userRole';
        const canApprove = currentUserRole === "Organization Owner" || currentUserRole === "Organization Admin";

        function escapeNotificationHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            })[character]);
        }

        function notificationIcon(type) {
            const icons = {
                Transaction: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>`,
                Approval: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`,
                Deletion: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>`,
                Bill: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>`,
                System: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>`,
                Audit: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`
            };

            return icons[type] || `<span style="font-size:14px;">●</span>`;
        }

        function notificationClass(type) {
            const classes = {
                Transaction: "status-paid",
                Approval: "status-pending",
                Deletion: "status-pending",
                Bill: "status-overdue",
                System: "status-paid",
                Audit: "status-paid"
            };

            return classes[type] || "status-pending";
        }

        async function markNotificationRead(id) {
            try {
                const res = await fetch("/api/notifications/mark-read", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id: Number(id) })
                });

                if (res.ok) {
                    await loadNotifications();
                }
            } catch (err) {
                console.error("Mark read error:", err);
            }
        }

        async function markAllRead() {
            try {
                const res = await fetch("/api/notifications/mark-all-read", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });

                if (res.ok) {
                    await loadNotifications();
                }
            } catch (err) {
                console.error("Mark all read error:", err);
            }
        }

        async function loadNotifications() {
            const search = document.getElementById("notificationSearch").value.trim();
            const typeFilter = document.getElementById("notificationType").value;
            const statusFilter = document.getElementById("notificationStatus").value;

            try {
                const params = new URLSearchParams({
                    search: search,
                    type: typeFilter,
                    status: statusFilter
                });

                const res = await fetch(`/api/notifications?${params.toString()}`);
                if (!res.ok) throw new Error("Failed to fetch notifications");
                const data = await res.json();

                liveNotifications = data.items || [];

                document.getElementById("totalNotifications").textContent = data.totalCount ?? 0;
                document.getElementById("unreadNotifications").textContent = data.unreadCount ?? 0;
                document.getElementById("actionNotifications").textContent = data.actionCount ?? 0;

                renderList();
            } catch (err) {
                console.error("Error loading notifications:", err);
            }
        }

        function renderList() {
            const container = document.getElementById("notificationList");
            const emptyEl = document.getElementById("emptyNotifications");

            if (liveNotifications.length === 0) {
                container.innerHTML = "";
                emptyEl.hidden = false;
                return;
            }

            emptyEl.hidden = true;
            container.innerHTML = liveNotifications.map(item => `
                <article style="
                    display:flex;
                    gap:16px;
                    align-items:flex-start;
                    padding:20px 4px;
                    border-bottom:1px solid #e5e7eb;
                    background:${item.unread ? "#f8fbff" : "transparent"};
                ">
                    <div style="
                        width:42px;
                        height:42px;
                        flex-shrink:0;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        border-radius:12px;
                        background:#eef2ff;
                        color:#334155;
                        font-size:20px;
                        font-weight:700;
                    ">
                        ${notificationIcon(item.type)}
                    </div>

                    <div style="flex:1;min-width:0;">
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            gap:12px;
                            flex-wrap:wrap;
                        ">
                            <strong>${escapeNotificationHtml(item.title)}</strong>
                            <span style="font-size:12px;color:#64748b;">
                                ${escapeNotificationHtml(item.time)}
                            </span>
                        </div>

                        <p style="margin:8px 0;color:#64748b;">
                            ${escapeNotificationHtml(item.message)}
                        </p>

                        <div style="
                            display:flex;
                            align-items:center;
                            gap:8px;
                            flex-wrap:wrap;
                        ">
                            <span class="status-badge ${notificationClass(item.type)}">
                                ${escapeNotificationHtml(item.type)}
                            </span>

                            <span style="font-size:12px;color:#64748b;">
                                ${escapeNotificationHtml(item.unit || "All Units")}
                            </span>

                            ${item.actionRequired
                                ? `<span class="status-badge status-overdue">Action required</span>`
                                : ""}

                            ${item.unread
                                ? `<span style="font-size:12px;color:#2563eb;font-weight:600;">Unread</span>`
                                : ""}
                        </div>
                    </div>

                    <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;">
                        ${item.actionRequired && (item.type === "Approval" || item.type === "Deletion") && canApprove
                            ? `<div style="display:flex;gap:6px;">
                                <button type="button" class="btn btn-sm btn-success" onclick="approveDeletion(${item.id})">✓ Approve</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="rejectDeletion(${item.id})">✕ Reject</button>
                               </div>`
                            : ""}
                        ${item.unread
                            ? `<button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                onclick="markNotificationRead(${item.id})">
                                Mark read
                               </button>`
                            : ""}
                    </div>
                </article>
            `).join("");
        }

        async function approveDeletion(id) {
            if (!confirm("Approve this deletion request? The transaction will be deleted and an audit log recorded.")) return;
            try {
                const res = await fetch("/api/notifications/approve-deletion", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id: Number(id) })
                });
                const result = await res.json();
                if (result.success) {
                    await loadNotifications();
                } else {
                    alert(result.message || "Failed to approve deletion.");
                }
            } catch (err) {
                alert("Network error approving deletion.");
            }
        }

        async function rejectDeletion(id) {
            if (!confirm("Reject this deletion request?")) return;
            try {
                const res = await fetch("/api/notifications/reject-deletion", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id: Number(id) })
                });
                const result = await res.json();
                if (result.success) {
                    await loadNotifications();
                } else {
                    alert(result.message || "Failed to reject deletion.");
                }
            } catch (err) {
                alert("Network error rejecting deletion.");
            }
        }

        document.getElementById("notificationSearch")
            .addEventListener("input", loadNotifications);

        document.getElementById("notificationType")
            .addEventListener("change", loadNotifications);

        document.getElementById("notificationStatus")
            .addEventListener("change", loadNotifications);

        loadNotifications();
    </script>
}
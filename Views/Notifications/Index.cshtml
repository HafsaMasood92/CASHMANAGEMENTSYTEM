@{
    ViewData["Title"] = "Notifications";
}

<div class="page-header">
    <div>
        <h1>Notifications</h1>
        <p>Stay updated on financial activity and items requiring your attention.</p>
    </div>

    <button type="button" class="btn btn-outline-secondary"
            onclick="markAllRead()">
        Mark all as read
    </button>
</div>

<section class="summary-grid">
    <article class="summary-card">
        <div class="summary-card-top">
            <span>Total Notifications</span>
            <span class="summary-icon">▤</span>
        </div>
        <h2 id="totalNotifications">0</h2>
        <p>All recent activity</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Unread</span>
            <span class="summary-icon">●</span>
        </div>
        <h2 id="unreadNotifications">0</h2>
        <p>Notifications not yet read</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Action Required</span>
            <span class="summary-icon">!</span>
        </div>
        <h2 id="actionNotifications">0</h2>
        <p>Items requiring review</p>
    </article>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h3>Notification center</h3>
            <p>Review updates from across the organization.</p>
        </div>
    </div>

    <div class="transaction-toolbar">
        <input id="notificationSearch" type="search"
               class="form-control"
               placeholder="Search notifications..." />

        <select id="notificationType" class="form-select">
            <option value="all">All types</option>
            <option value="Transaction">Financial activity</option>
            <option value="Deletion">Deletion requests</option>
            <option value="Bill">Bills & payments</option>
            <option value="System">System updates</option>
        </select>

        <select id="notificationStatus" class="form-select">
            <option value="all">All notifications</option>
            <option value="unread">Unread only</option>
            <option value="read">Read only</option>
            <option value="action">Action required</option>
        </select>
    </div>

    <div id="notificationList"></div>

    <div id="emptyNotifications" hidden
         style="padding:40px 16px;text-align:center;">
        <h3>No notifications found</h3>
        <p>Try changing your search or filters.</p>
    </div>

    <p class="preview-note">
        Preview only: notification changes are temporary and reset on refresh.
    </p>
</section>

@section Scripts {
    <script>
        const notifications = [
            {
                id: 1,
                type: "Deletion",
                title: "Deletion request requires approval",
                message: "An accountant has requested deletion of a financial entry. Review the request before approving or rejecting it.",
                unit: "School",
                time: "Just now",
                unread: true,
                actionRequired: true
            },
            {
                id: 2,
                type: "Bill",
                title: "Bill is overdue",
                message: "A College bill has passed its due date and still has an unpaid balance.",
                unit: "College",
                time: "Today",
                unread: true,
                actionRequired: true
            },
            {
                id: 3,
                type: "Transaction",
                title: "New expense recorded",
                message: "A new expense entry was added and included in the current financial totals.",
                unit: "BS Program",
                time: "Today",
                unread: true,
                actionRequired: false
            },
            {
                id: 4,
                type: "Transaction",
                title: "Revenue entry updated",
                message: "An accountant edited a revenue entry. The updated amount is reflected in the totals.",
                unit: "Training Center",
                time: "Yesterday",
                unread: false,
                actionRequired: false
            },
            {
                id: 5,
                type: "Bill",
                title: "Partial bill payment recorded",
                message: "A bill payment was recorded. The remaining unpaid amount is still outstanding.",
                unit: "Evening Academy",
                time: "Yesterday",
                unread: false,
                actionRequired: false
            },
            {
                id: 6,
                type: "System",
                title: "Account activity recorded",
                message: "Recent activity has been recorded for review and audit purposes.",
                unit: "All Units",
                time: "2 days ago",
                unread: false,
                actionRequired: false
            }
        ];

        function escapeNotificationHtml(value) {
            return String(value).replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            })[character]);
        }

        function notificationIcon(type) {
            const icons = {
                Transaction: "↕",
                Deletion: "!",
                Bill: "▤",
                System: "⚙"
            };

            return icons[type] || "•";
        }

        function notificationClass(type) {
            const classes = {
                Transaction: "status-paid",
                Deletion: "status-pending",
                Bill: "status-overdue",
                System: "status-paid"
            };

            return classes[type] || "status-pending";
        }

        function markNotificationRead(id) {
            const item = notifications.find(n => n.id === id);

            if (item) {
                item.unread = false;
                renderNotifications();
            }
        }

        function markAllRead() {
            notifications.forEach(item => {
                item.unread = false;
            });

            renderNotifications();
        }

        function renderNotifications() {
            const search = document.getElementById("notificationSearch")
                .value.trim().toLowerCase();

            const typeFilter = document.getElementById("notificationType").value;
            const statusFilter = document.getElementById("notificationStatus").value;

            const filtered = notifications.filter(item => {
                const searchableText =
                    `${item.title} ${item.message} ${item.unit} ${item.type}`
                        .toLowerCase();

                const matchesSearch = searchableText.includes(search);
                const matchesType =
                    typeFilter === "all" || item.type === typeFilter;

                let matchesStatus = true;

                if (statusFilter === "unread") {
                    matchesStatus = item.unread;
                } else if (statusFilter === "read") {
                    matchesStatus = !item.unread;
                } else if (statusFilter === "action") {
                    matchesStatus = item.actionRequired;
                }

                return matchesSearch && matchesType && matchesStatus;
            });

            document.getElementById("notificationList").innerHTML =
                filtered.map(item => `
                    <article style="
                        display:flex;
                        gap:16px;
                        align-items:flex-start;
                        padding:20px 4px;
                        border-bottom:1px solid #e5e7eb;
                        background:${item.unread ? "#f8fbff" : "transparent"};
                    ">
                        <div style="
                            width:42px;
                            height:42px;
                            flex-shrink:0;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            border-radius:12px;
                            background:#eef2ff;
                            color:#334155;
                            font-size:20px;
                            font-weight:700;
                        ">
                            ${notificationIcon(item.type)}
                        </div>

                        <div style="flex:1;min-width:0;">
                            <div style="
                                display:flex;
                                justify-content:space-between;
                                gap:12px;
                                flex-wrap:wrap;
                            ">
                                <strong>${escapeNotificationHtml(item.title)}</strong>
                                <span style="font-size:12px;color:#64748b;">
                                    ${escapeNotificationHtml(item.time)}
                                </span>
                            </div>

                            <p style="margin:8px 0;color:#64748b;">
                                ${escapeNotificationHtml(item.message)}
                            </p>

                            <div style="
                                display:flex;
                                align-items:center;
                                gap:8px;
                                flex-wrap:wrap;
                            ">
                                <span class="status-badge ${notificationClass(item.type)}">
                                    ${escapeNotificationHtml(item.type)}
                                </span>

                                <span style="font-size:12px;color:#64748b;">
                                    ${escapeNotificationHtml(item.unit)}
                                </span>

                                ${item.actionRequired
                                    ? `<span class="status-badge status-overdue">Action required</span>`
                                    : ""}

                                ${item.unread
                                    ? `<span style="font-size:12px;color:#2563eb;font-weight:600;">Unread</span>`
                                    : ""}
                            </div>
                        </div>

                        <div>
                            ${item.unread
                                ? `<button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    onclick="markNotificationRead(${item.id})">
                                    Mark read
                                   </button>`
                                : ""}
                        </div>
                    </article>
                `).join("");

            document.getElementById("emptyNotifications").hidden =
                filtered.length !== 0;

            document.getElementById("totalNotifications").textContent =
                notifications.length;

            document.getElementById("unreadNotifications").textContent =
                notifications.filter(item => item.unread).length;

            document.getElementById("actionNotifications").textContent =
                notifications.filter(item => item.actionRequired).length;
        }

        document.getElementById("notificationSearch")
            .addEventListener("input", renderNotifications);

        document.getElementById("notificationType")
            .addEventListener("change", renderNotifications);

        document.getElementById("notificationStatus")
            .addEventListener("change", renderNotifications);

        renderNotifications();
    </script>
}
@{
    ViewData["Title"] = "Financial Reports";
}

<div class="page-header">
    <div>
        <h1>Financial Reports</h1>
        <p>Review financial performance across your organizational units.</p>
    </div>

    <button type="button" class="btn btn-primary" onclick="exportReport()">
        ↓ Export CSV
    </button>
</div>

<section class="panel">
    <div class="panel-header">
        <div>
            <h3>Report filters</h3>
            <p>Select a reporting period and organizational unit.</p>
        </div>
    </div>

    <div class="transaction-toolbar">
        <select id="reportPeriod" class="form-select">
            <option value="month">This Month</option>
            <option value="lastMonth">Last Month</option>
            <option value="year">This Year</option>
            <option value="all">All Time</option>
        </select>

        <select id="reportUnit" class="form-select">
            <option value="all">All Organizational Units</option>
            <option value="School">School</option>
            <option value="College">College</option>
            <option value="BS Program">BS Program</option>
            <option value="Training Center">Training Center</option>
            <option value="Evening Academy">Evening Academy</option>
        </select>
    </div>
</section>

<section class="summary-grid">
    <article class="summary-card">
        <div class="summary-card-top">
            <span>Period Revenue</span>
            <span class="summary-icon">↗</span>
        </div>
        <h2 id="reportRevenue">Rs. 0</h2>
        <p>Total income for the selected period</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Period Expenses</span>
            <span class="summary-icon">↘</span>
        </div>
        <h2 id="reportExpenses">Rs. 0</h2>
        <p>Total expenses for the selected period</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Net Balance</span>
            <span class="summary-icon">=</span>
        </div>
        <h2 id="reportNet">Rs. 0</h2>
        <p>All-time income minus all-time expenses</p>
    </article>

    <article class="summary-card">
        <div class="summary-card-top">
            <span>Outstanding Bills</span>
            <span class="summary-icon">!</span>
        </div>
        <h2 id="reportOutstanding">Rs. 0</h2>
        <p>Remaining unpaid amount, including overdue bills</p>
    </article>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h3>Monthly financial overview</h3>
            <p>Revenue versus expenses for the current year.</p>
        </div>
    </div>

    <div id="monthlyChart"
         style="display:grid; gap:18px; padding:12px 0;">
    </div>

    <div style="display:flex; gap:20px; flex-wrap:wrap; margin-top:20px;">
        <span style="display:flex; align-items:center; gap:8px;">
            <span style="width:12px;height:12px;border-radius:3px;background:#2563eb;display:inline-block;"></span>
            Revenue
        </span>
        <span style="display:flex; align-items:center; gap:8px;">
            <span style="width:12px;height:12px;border-radius:3px;background:#f59e0b;display:inline-block;"></span>
            Expenses
        </span>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h3>Organizational unit breakdown</h3>
            <p>Compare financial performance across all five units.</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Organizational Unit</th>
                    <th>Revenue</th>
                    <th>Expenses</th>
                    <th>Net Balance</th>
                    <th>Outstanding Bills</th>
                </tr>
            </thead>
            <tbody id="unitReportRows"></tbody>
        </table>
    </div>

    <p class="preview-note">
        Demo report: figures are sample data for interface review only.
        CSV export contains the figures currently displayed in the report.
    </p>
</section>

@section Scripts {
    <script>
        // DEMO DATA ONLY — no database connection yet.
        // Dates use YYYY-MM-DD format.

        const reportTransactions = [
            { date: "2026-10-02", unit: "School", type: "Revenue", amount: 180000 },
            { date: "2026-10-04", unit: "School", type: "Expense", amount: 65000 },
            { date: "2026-10-05", unit: "College", type: "Revenue", amount: 240000 },
            { date: "2026-10-06", unit: "College", type: "Expense", amount: 95000 },
            { date: "2026-10-07", unit: "BS Program", type: "Revenue", amount: 320000 },
            { date: "2026-10-08", unit: "BS Program", type: "Expense", amount: 125000 },
            { date: "2026-10-09", unit: "Training Center", type: "Revenue", amount: 110000 },
            { date: "2026-10-10", unit: "Training Center", type: "Expense", amount: 42000 },
            { date: "2026-10-11", unit: "Evening Academy", type: "Revenue", amount: 85000 },
            { date: "2026-10-12", unit: "Evening Academy", type: "Expense", amount: 30000 },

            { date: "2026-09-05", unit: "School", type: "Revenue", amount: 160000 },
            { date: "2026-09-08", unit: "School", type: "Expense", amount: 60000 },
            { date: "2026-09-06", unit: "College", type: "Revenue", amount: 220000 },
            { date: "2026-09-09", unit: "College", type: "Expense", amount: 90000 },
            { date: "2026-09-07", unit: "BS Program", type: "Revenue", amount: 300000 },
            { date: "2026-09-10", unit: "BS Program", type: "Expense", amount: 118000 },
            { date: "2026-09-12", unit: "Training Center", type: "Revenue", amount: 95000 },
            { date: "2026-09-15", unit: "Training Center", type: "Expense", amount: 40000 },
            { date: "2026-09-14", unit: "Evening Academy", type: "Revenue", amount: 75000 },
            { date: "2026-09-18", unit: "Evening Academy", type: "Expense", amount: 28000 },

            { date: "2026-04-10", unit: "School", type: "Revenue", amount: 140000 },
            { date: "2026-05-10", unit: "School", type: "Revenue", amount: 150000 },
            { date: "2026-06-10", unit: "College", type: "Revenue", amount: 190000 },
            { date: "2026-07-10", unit: "College", type: "Expense", amount: 70000 },
            { date: "2026-08-10", unit: "BS Program", type: "Revenue", amount: 250000 },
            { date: "2026-08-12", unit: "BS Program", type: "Expense", amount: 100000 }
        ];

        const reportBills = [
            { unit: "School", amount: 30000, paid: 10000, dueDate: "2026-10-20" },
            { unit: "College", amount: 50000, paid: 20000, dueDate: "2026-10-08" },
            { unit: "BS Program", amount: 40000, paid: 0, dueDate: "2026-10-25" },
            { unit: "Training Center", amount: 15000, paid: 5000, dueDate: "2026-10-18" },
            { unit: "Evening Academy", amount: 12000, paid: 0, dueDate: "2026-10-05" }
        ];

        const reportUnits = [
            "School",
            "College",
            "BS Program",
            "Training Center",
            "Evening Academy"
        ];

        function reportMoney(amount) {
            return "Rs. " + Math.round(amount).toLocaleString("en-PK");
        }

        function getPeriodTransactions() {
            const period = document.getElementById("reportPeriod").value;
            const selectedUnit = document.getElementById("reportUnit").value;
            const now = new Date();

            return reportTransactions.filter(transaction => {
                const date = new Date(transaction.date + "T12:00:00");

                const matchesUnit =
                    selectedUnit === "all" || transaction.unit === selectedUnit;

                let matchesPeriod = true;

                if (period === "month") {
                    matchesPeriod =
                        date.getFullYear() === now.getFullYear() &&
                        date.getMonth() === now.getMonth();
                } else if (period === "lastMonth") {
                    const lastMonth = new Date(
                        now.getFullYear(),
                        now.getMonth() - 1,
                        1
                    );

                    matchesPeriod =
                        date.getFullYear() === lastMonth.getFullYear() &&
                        date.getMonth() === lastMonth.getMonth();
                } else if (period === "year") {
                    matchesPeriod = date.getFullYear() === now.getFullYear();
                }

                return matchesUnit && matchesPeriod;
            });
        }

        function getUnitFigures(unit) {
            const selectedUnit = document.getElementById("reportUnit").value;
            const matchesUnit = selectedUnit === "all" || selectedUnit === unit;

            const transactions = reportTransactions.filter(transaction =>
                transaction.unit === unit
            );

            const revenue = transactions
                .filter(transaction => transaction.type === "Revenue")
                .reduce((sum, transaction) => sum + transaction.amount, 0);

            const expenses = transactions
                .filter(transaction => transaction.type === "Expense")
                .reduce((sum, transaction) => sum + transaction.amount, 0);

            const outstanding = reportBills
                .filter(bill => bill.unit === unit)
                .reduce((sum, bill) =>
                    sum + Math.max(0, bill.amount - bill.paid), 0);

            return {
                unit,
                revenue: matchesUnit ? revenue : 0,
                expenses: matchesUnit ? expenses : 0,
                net: matchesUnit ? revenue - expenses : 0,
                outstanding: matchesUnit ? outstanding : 0
            };
        }

        function renderReport() {
            const transactions = getPeriodTransactions();

            const periodRevenue = transactions
                .filter(item => item.type === "Revenue")
                .reduce((sum, item) => sum + item.amount, 0);

            const periodExpenses = transactions
                .filter(item => item.type === "Expense")
                .reduce((sum, item) => sum + item.amount, 0);

            const selectedUnit = document.getElementById("reportUnit").value;

            const visibleUnits = selectedUnit === "all"
                ? reportUnits
                : [selectedUnit];

            const allFigures = visibleUnits.map(getUnitFigures);

            // Net balance is based on all-time revenue and expenses.
            const allTimeNet = allFigures.reduce((sum, item) => sum + item.net, 0);

            // Outstanding includes partially paid and overdue bills.
            // Overdue is not counted separately, so there is no double-counting.
            const outstanding = allFigures.reduce(
                (sum, item) => sum + item.outstanding, 0
            );

            document.getElementById("reportRevenue").textContent =
                reportMoney(periodRevenue);

            document.getElementById("reportExpenses").textContent =
                reportMoney(periodExpenses);

            document.getElementById("reportNet").textContent =
                reportMoney(allTimeNet);

            document.getElementById("reportOutstanding").textContent =
                reportMoney(outstanding);

            renderMonthlyChart();
            renderUnitTable();
        }

        function renderMonthlyChart() {
            const selectedUnit = document.getElementById("reportUnit").value;
            const currentYear = new Date().getFullYear();

            const months = [
                "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
            ];

            const monthlyData = months.map((month, index) => {
                const transactions = reportTransactions.filter(item => {
                    const date = new Date(item.date + "T12:00:00");

                    return date.getFullYear() === currentYear &&
                        date.getMonth() === index &&
                        (selectedUnit === "all" || item.unit === selectedUnit);
                });

                return {
                    month,
                    revenue: transactions
                        .filter(item => item.type === "Revenue")
                        .reduce((sum, item) => sum + item.amount, 0),
                    expenses: transactions
                        .filter(item => item.type === "Expense")
                        .reduce((sum, item) => sum + item.amount, 0)
                };
            });

            const maxValue = Math.max(
                1,
                ...monthlyData.map(item => Math.max(item.revenue, item.expenses))
            );

            document.getElementById("monthlyChart").innerHTML =
                monthlyData.map(item => `
                    <div style="display:grid;grid-template-columns:36px minmax(0,1fr);gap:12px;align-items:center;">
                        <span style="font-size:13px;color:#64748b;">${item.month}</span>
                        <div style="display:grid;gap:5px;">
                            <div title="Revenue: ${reportMoney(item.revenue)}"
                                 style="height:12px;width:${item.revenue / maxValue * 100}%;min-width:${item.revenue ? 3 : 0}px;background:#2563eb;border-radius:4px;">
                            </div>
                            <div title="Expenses: ${reportMoney(item.expenses)}"
                                 style="height:12px;width:${item.expenses / maxValue * 100}%;min-width:${item.expenses ? 3 : 0}px;background:#f59e0b;border-radius:4px;">
                            </div>
                        </div>
                    </div>
                `).join("");
        }

        function renderUnitTable() {
            const selectedUnit = document.getElementById("reportUnit").value;

            const visibleUnits = selectedUnit === "all"
                ? reportUnits
                : [selectedUnit];

            document.getElementById("unitReportRows").innerHTML =
                visibleUnits.map(unit => {
                    const figures = getUnitFigures(unit);

                    return `
                        <tr>
                            <td><strong>${unit}</strong></td>
                            <td>${reportMoney(figures.revenue)}</td>
                            <td>${reportMoney(figures.expenses)}</td>
                            <td>${reportMoney(figures.net)}</td>
                            <td>${reportMoney(figures.outstanding)}</td>
                        </tr>
                    `;
                }).join("");
        }

        function exportReport() {
            const transactions = getPeriodTransactions();

            const rows = [
                ["Financial Report"],
                ["Period", document.getElementById("reportPeriod").selectedOptions[0].text],
                ["Unit", document.getElementById("reportUnit").value],
                [],
                ["Organizational Unit", "All-Time Revenue", "All-Time Expenses", "All-Time Net Balance", "Outstanding Bills"]
            ];

            const selectedUnit = document.getElementById("reportUnit").value;

            const visibleUnits = selectedUnit === "all"
                ? reportUnits
                : [selectedUnit];

            visibleUnits.forEach(unit => {
                const figures = getUnitFigures(unit);

                rows.push([
                    unit,
                    figures.revenue,
                    figures.expenses,
                    figures.net,
                    figures.outstanding
                ]);
            });

            rows.push([]);
            rows.push(["Selected Period Transactions"]);
            rows.push(["Date", "Unit", "Type", "Amount"]);

            transactions.forEach(item => {
                rows.push([item.date, item.unit, item.type, item.amount]);
            });

            const csv = rows.map(row =>
                row.map(value => {
                    const text = String(value ?? "");
                    return '"' + text.replace(/"/g, '""') + '"';
                }).join(",")
            ).join("\r\n");

            const blob = new Blob(["\uFEFF" + csv], {
                type: "text/csv;charset=utf-8;"
            });

            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");

            link.href = url;
            link.download = "financial-report.csv";
            link.click();

            URL.revokeObjectURL(url);
        }

        document.getElementById("reportPeriod")
            .addEventListener("change", renderReport);

        document.getElementById("reportUnit")
            .addEventListener("change", renderReport);

        renderReport();
    </script>
}
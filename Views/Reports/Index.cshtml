@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pb-2 border-bottom">
    <div>
        <h1 class="h4 mb-1 text-dark fw-bold">Reports</h1>
        <p class="text-muted small mb-0">Financial statements and period breakdown.</p>
    </div>

    <button type="button" class="btn btn-outline-primary btn-sm px-3 d-inline-flex align-items-center gap-2" onclick="exportReportCsv()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        <span>Export CSV</span>
    </button>
</div>

<!-- Filter Toolbar -->
<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-sm-6 col-md-4">
                <label for="reportPeriod" class="form-label small fw-semibold text-muted mb-1">Reporting Period</label>
                <select id="reportPeriod" class="form-select form-select-sm" style="border-radius:8px;">
                    <option value="month">This Month</option>
                    <option value="lastMonth">Last Month</option>
                    <option value="year">This Year</option>
                    <option value="all">All Time</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <label for="reportUnit" class="form-label small fw-semibold text-muted mb-1">Organizational Unit</label>
                <select id="reportUnit" class="form-select form-select-sm" style="border-radius:8px;">
                    @{
                        var repUnits = (ViewBag.AvailableUnits as List<string>) ?? (ViewData["AllowedUnits"] as List<string>) ?? new List<string>();
                    }
                    @if (repUnits.Count > 1)
                    {
                        <option value="all">All Authorized Units</option>
                    }
                    @foreach (var u in repUnits)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                    <span>Period Revenue</span>
                    <div class="p-2 rounded" style="background:#ecfdf5;color:#059669;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    </div>
                </div>
                <div class="h3 fw-bold mb-1 text-dark" id="reportRevenue">Rs. 0</div>
                <span class="small text-muted">Income in selected period</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                    <span>Period Expenses</span>
                    <div class="p-2 rounded" style="background:#fef2f2;color:#dc2626;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                </div>
                <div class="h3 fw-bold mb-1 text-dark" id="reportExpenses">Rs. 0</div>
                <span class="small text-muted">Expenses in selected period</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                    <span>All-Time Net Balance</span>
                    <div class="p-2 rounded" style="background:#eff6ff;color:#2563eb;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    </div>
                </div>
                <div class="h3 fw-bold mb-1 text-dark" id="reportNet">Rs. 0</div>
                <span class="small text-muted">Cumulative net liquidity</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                    <span>Outstanding Liabilities</span>
                    <div class="p-2 rounded" style="background:#fffbeb;color:#d97706;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </div>
                </div>
                <div class="h3 fw-bold mb-1 text-dark" id="reportOutstanding">Rs. 0</div>
                <span class="small text-muted">Unpaid vendor commitments</span>
            </div>
        </div>
    </div>
</div>

<!-- Annual Monthly Flow Chart -->
<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h6 class="card-title mb-0 fw-bold text-dark">Cash Flow Distribution</h6>
        </div>
        <div class="d-flex gap-3 small text-muted">
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width:10px;height:10px;background:#356ae6;border-radius:2px;display:inline-block;"></span> Revenue
            </span>
            <span class="d-inline-flex align-items-center gap-1">
                <span style="width:10px;height:10px;background:#f59e0b;border-radius:2px;display:inline-block;"></span> Expenses
            </span>
        </div>
    </div>
    <div class="card-body p-4">
        <div id="monthlyChart" style="display:grid; gap:14px;"></div>
    </div>
</div>

<!-- Unit Breakdown Table -->
<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="card-title mb-0 fw-bold text-dark">Unit Performance Breakdown</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-muted">
                <tr>
                    <th class="ps-3">Organizational Unit</th>
                    <th>Period Revenue</th>
                    <th>Period Expenses</th>
                    <th>Operating Net</th>
                    <th class="text-end pe-3">Outstanding Bills</th>
                </tr>
            </thead>
            <tbody id="unitReportRows">
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">Loading unit data...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(() => {
    let currentTransactions = [];

    const money = value =>
        "Rs. " + Math.round(value || 0).toLocaleString("en-PK");

    async function loadReportData() {
        const period = document.getElementById("reportPeriod").value;
        const unit = document.getElementById("reportUnit").value;

        try {
            const res = await fetch(`/api/reports/data?period=${encodeURIComponent(period)}&unit=${encodeURIComponent(unit)}`);
            if (!res.ok) throw new Error("Failed to fetch reports");
            const data = await res.json();

            document.getElementById("reportRevenue").textContent = money(data.periodRevenue);
            document.getElementById("reportExpenses").textContent = money(data.periodExpenses);
            document.getElementById("reportNet").textContent = money(data.allTimeNet);
            document.getElementById("reportOutstanding").textContent = money(data.totalOutstanding);

            currentTransactions = data.transactions || [];

            // Monthly chart
            const chartElem = document.getElementById("monthlyChart");
            if (chartElem && data.months) {
                const maxVal = Math.max(1, ...data.months.flatMap(m => [m.revenue, m.expenses]));
                chartElem.innerHTML = data.months.map(m => `
                    <div style="display:grid;grid-template-columns:40px minmax(0,1fr);gap:12px;align-items:center;">
                        <span class="small text-muted" style="font-size:12px;font-weight:600;">${m.month}</span>
                        <div style="display:grid;gap:4px;">
                            <div title="Revenue: ${money(m.revenue)}"
                                 style="height:10px;width:${Math.max(2, (m.revenue / maxVal) * 100)}%;background:#356ae6;border-radius:3px;">
                            </div>
                            <div title="Expenses: ${money(m.expenses)}"
                                 style="height:10px;width:${Math.max(2, (m.expenses / maxVal) * 100)}%;background:#f59e0b;border-radius:3px;">
                            </div>
                        </div>
                    </div>
                `).join("");
            }

            // Unit breakdown
            const tbody = document.getElementById("unitReportRows");
            if (tbody && data.unitBreakdown) {
                if (data.unitBreakdown.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No unit metrics recorded.</td></tr>';
                } else {
                    tbody.innerHTML = data.unitBreakdown.map(u => {
                        const isPos = u.net >= 0;
                        const netColor = isPos ? "text-success fw-semibold" : "text-danger fw-semibold";
                        return `
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">${u.unit}</td>
                                <td>${money(u.revenue)}</td>
                                <td>${money(u.expenses)}</td>
                                <td class="${netColor}">${money(u.net)}</td>
                                <td class="text-end pe-3">${money(u.outstanding)}</td>
                            </tr>
                        `;
                    }).join("");
                }
            }
        } catch (err) {
            console.error("Report data load error:", err);
        }
    }

    window.exportReportCsv = function() {
        if (!currentTransactions || currentTransactions.length === 0) {
            alert("No transaction records available for export.");
            return;
        }

        const headers = ["Date", "Unit", "Type", "Description", "Amount"];
        const rows = currentTransactions.map(t => [
            t.date,
            `"${(t.unit || '').replace(/"/g, '""')}"`,
            t.type,
            `"${(t.description || '').replace(/"/g, '""')}"`,
            t.amount
        ]);

        const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `financial_report_${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    document.getElementById("reportPeriod").addEventListener("change", loadReportData);
    document.getElementById("reportUnit").addEventListener("change", loadReportData);

    loadReportData();
})();
</script>
}
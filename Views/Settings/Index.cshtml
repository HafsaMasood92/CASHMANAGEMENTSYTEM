@{
    ViewData["Title"] = "Organization Settings";
}

<style>
    .settings-layout {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .settings-nav {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px;
        position: sticky;
        top: 20px;
    }

    .settings-nav-label {
        padding: 10px 12px 6px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .settings-nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 11px 12px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #475569;
        text-align: left;
        font-size: 13.5px;
        font-weight: 500;
        cursor: pointer;
        margin-bottom: 2px;
        transition: all 0.15s ease;
    }

    .settings-nav-item:hover {
        background: #f8fafc;
        color: #2563eb;
    }

    .settings-nav-item.active {
        background: #eff6ff;
        color: #2563eb;
        font-weight: 600;
    }

    .settings-nav-icon {
        width: 20px;
        text-align: center;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .settings-content {
        min-width: 0;
    }

    .settings-section {
        display: none;
    }

    .settings-section.active {
        display: block;
    }

    .settings-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
    }

    .settings-card-heading {
        padding-bottom: 16px;
        margin-bottom: 20px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .settings-card-heading h3 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 4px;
        color: #0f172a;
    }

    .settings-card-heading p {
        font-size: 13px;
        color: #64748b;
        margin: 0;
    }

    .settings-field {
        margin-bottom: 18px;
    }

    .settings-field:last-child {
        margin-bottom: 0;
    }

    .settings-field label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #334155;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .settings-toggle-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        padding: 16px 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .settings-toggle-row:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .settings-toggle-row strong {
        display: block;
        color: #334155;
        font-size: 13.5px;
        margin-bottom: 4px;
    }

    .settings-toggle-row p {
        color: #64748b;
        font-size: 12.5px;
        margin: 0;
        line-height: 1.5;
    }

    .settings-toggle-row input[type="checkbox"] {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        margin-top: 2px;
        accent-color: #2563eb;
        cursor: pointer;
    }

    .settings-page-title {
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 12px;
    }

    .settings-page-title h2 {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 6px;
        color: #0f172a;
    }

    .settings-page-title p {
        font-size: 13px;
        color: #64748b;
        margin: 0;
    }

    .settings-table th {
        font-size: 11.5px;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #64748b;
        background: #f8fafc;
        white-space: nowrap;
        padding: 10px 14px;
    }

    .settings-table td {
        font-size: 13px;
        vertical-align: middle;
        padding: 12px 14px;
    }

    .settings-inline-form {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .settings-inline-form .form-control {
        flex: 1;
        min-width: 200px;
    }

    .settings-empty {
        padding: 30px 12px;
        text-align: center;
        color: #94a3b8;
        font-size: 13px;
    }

    .settings-notice {
        padding: 14px 16px;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        color: #1e40af;
        border-radius: 10px;
        font-size: 12.5px;
        line-height: 1.6;
        margin-bottom: 18px;
    }

    .settings-alert {
        display: none;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    @@media (max-width: 850px) {
        .settings-layout {
            grid-template-columns: 1fr;
        }

        .settings-nav {
            position: static;
            display: flex;
            gap: 6px;
            overflow-x: auto;
        }

        .settings-nav-label {
            display: none;
        }

        .settings-nav-item {
            width: auto;
            flex-shrink: 0;
        }

        .settings-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>

<div class="page-header mb-4">
    <div>
        <h1 class="h3 mb-1">Organization Settings</h1>
        <p class="text-muted mb-0">Manage your organization profile, financial settings, and categories.</p>
    </div>
</div>

<div class="settings-layout">

    <!-- SETTINGS SIDEBAR NAV -->
    <aside class="settings-nav">
        <div class="settings-nav-label">General</div>

        <button type="button" class="settings-nav-item active" data-section="profile">
            <span class="settings-nav-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>
            </span>
            <span class="settings-nav-text">Organization Profile</span>
        </button>

        <button type="button" class="settings-nav-item" data-section="categories">
            <span class="settings-nav-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            </span>
            <span class="settings-nav-text">Financial Categories</span>
        </button>

        <button type="button" class="settings-nav-item" data-section="preferences">
            <span class="settings-nav-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v12M17 10h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H7"></path></svg>
            </span>
            <span class="settings-nav-text">Financial Preferences</span>
        </button>

        <button type="button" class="settings-nav-item" data-section="users">
            <span class="settings-nav-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </span>
            <span class="settings-nav-text">Users &amp; Permissions</span>
        </button>

        <button type="button" class="settings-nav-item" data-section="notifications">
            <span class="settings-nav-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            </span>
            <span class="settings-nav-text">Notification Settings</span>
        </button>
    </aside>

    <!-- SETTINGS CONTENT -->
    <main class="settings-content">

        <!-- Global Feedback Alert -->
        <div id="settingsFeedback" class="settings-alert" role="status"></div>

        <!-- 1. ORG ADMIN: ORGANIZATION PROFILE -->
        <section class="settings-section active" id="section-profile">
            <div class="settings-page-title">
                <div>
                    <h2>Organization Profile</h2>
                    <p>Manage basic identifying information displayed across reports and ledgers.</p>
                </div>
                <button type="button" class="btn btn-primary" id="saveProfileBtn">Save Profile</button>
            </div>

            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Institution Details</h3>
                        <p>Primary details of your organization.</p>
                    </div>
                </div>

                <div class="settings-grid">
                    <div class="settings-field">
                        <label for="orgName">Organization Name *</label>
                        <input id="orgName" class="form-control" placeholder="e.g. Army Public School" required />
                    </div>

                    <div class="settings-field">
                        <label for="orgEmail">Official Email *</label>
                        <input id="orgEmail" type="email" class="form-control" placeholder="admin@organization.com" />
                    </div>

                    <div class="settings-field">
                        <label for="orgPhone">Contact Number</label>
                        <input id="orgPhone" class="form-control" placeholder="+92 300 1234567" />
                    </div>

                    <div class="settings-field">
                        <label for="orgAddress">Campus / Office Address</label>
                        <input id="orgAddress" class="form-control" placeholder="Street, City, Postal Code" />
                    </div>

                    <div class="settings-field">
                        <label for="orgTimezone">Time Zone</label>
                        <select id="orgTimezone" class="form-select">
                            <option value="Asia/Karachi">Pakistan Standard Time (PKT)</option>
                            <option value="UTC">UTC</option>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. ORG ADMIN: FINANCIAL CATEGORIES -->
        <section class="settings-section" id="section-categories">
            <div class="settings-page-title">
                <div>
                    <h2>Financial Categories</h2>
                    <p>Create and manage revenue, expense, and bill categories for your organization.</p>
                </div>
            </div>

            <div class="settings-notice">
                <strong>Category Protection:</strong> Categories added here will appear in your revenue, expense, and bill dropdowns. Categories in active financial records cannot be removed to preserve reporting integrity.
            </div>

            <!-- REVENUE CATEGORIES -->
            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Revenue Categories</h3>
                        <p>Categories for tracking income entries.</p>
                    </div>
                </div>

                <form id="revenueCategoryForm" class="settings-inline-form">
                    <input id="revenueCategoryName" class="form-control" placeholder="New revenue category name" maxlength="80" required />
                    <button class="btn btn-primary" type="submit">+ Add Category</button>
                </form>

                <div class="table-responsive">
                    <table class="table settings-table align-middle">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="revenueCategoryRows"></tbody>
                    </table>
                </div>
            </div>

            <!-- EXPENSE CATEGORIES -->
            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Expense Categories</h3>
                        <p>Categories for tracking operational and capital costs.</p>
                    </div>
                </div>

                <form id="expenseCategoryForm" class="settings-inline-form">
                    <input id="expenseCategoryName" class="form-control" placeholder="New expense category name" maxlength="80" required />
                    <button class="btn btn-primary" type="submit">+ Add Category</button>
                </form>

                <div class="table-responsive">
                    <table class="table settings-table align-middle">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="expenseCategoryRows"></tbody>
                    </table>
                </div>
            </div>

            <!-- BILL CATEGORIES -->
            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Bill &amp; Payable Categories</h3>
                        <p>Categories for vendor commitments and recurring bills.</p>
                    </div>
                </div>

                <form id="billCategoryForm" class="settings-inline-form">
                    <input id="billCategoryName" class="form-control" placeholder="New bill category name" maxlength="80" required />
                    <button class="btn btn-primary" type="submit">+ Add Category</button>
                </form>

                <div class="table-responsive">
                    <table class="table settings-table align-middle">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="billCategoryRows"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 3. ORG ADMIN: FINANCIAL PREFERENCES -->
        <section class="settings-section" id="section-preferences">
            <div class="settings-page-title">
                <div>
                    <h2>Financial Preferences</h2>
                    <p>Configure currencies, date formats, and transaction validation rules.</p>
                </div>
                <button type="button" class="btn btn-primary" id="savePreferencesBtn">Save Preferences</button>
            </div>

            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Financial Display Options</h3>
                        <p>Formatting rules for currency and dates.</p>
                    </div>
                </div>

                <div class="settings-grid">
                    <div class="settings-field">
                        <label for="currency">Operating Currency</label>
                        <select id="currency" class="form-select">
                            <option value="PKR">PKR — Pakistani Rupee</option>
                            <option value="USD">USD — US Dollar</option>
                            <option value="EUR">EUR — Euro</option>
                            <option value="AED">AED — UAE Dirham</option>
                            <option value="SAR">SAR — Saudi Riyal</option>
                        </select>
                    </div>

                    <div class="settings-field">
                        <label for="dateFormat">Date Format</label>
                        <select id="dateFormat" class="form-select">
                            <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                            <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                            <option value="MM/DD/YYYY">MM/DD/YYYY</option>
                        </select>
                    </div>

                    <div class="settings-field">
                        <label for="decimalPlaces">Decimal Precision</label>
                        <select id="decimalPlaces" class="form-select">
                            <option value="0">0 — Whole numbers</option>
                            <option value="2">2 — Two decimal places</option>
                        </select>
                    </div>

                    <div class="settings-field">
                        <label for="defaultPayment">Default Payment Account</label>
                        <select id="defaultPayment" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="Bank Account">Bank Account</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Transaction Rules &amp; Controls</h3>
                        <p>Enforce accuracy and integrity across financial ledgers.</p>
                    </div>
                </div>

                <div class="settings-toggle-row">
                    <div>
                        <strong>Require transaction description</strong>
                        <p>Every revenue and expense entry must include an explanatory description.</p>
                    </div>
                    <input type="checkbox" id="requireDescription" checked />
                </div>

                <div class="settings-toggle-row">
                    <div>
                        <strong>Maintain complete audit trail</strong>
                        <p>Log the creator, timestamp, and modification details on all transactions.</p>
                    </div>
                    <input type="checkbox" id="enableAudit" checked />
                </div>

                <div class="settings-toggle-row">
                    <div>
                        <strong>Allow partial bill payments</strong>
                        <p>Enable paying vendor bills across multiple installments.</p>
                    </div>
                    <input type="checkbox" id="allowPartialPayments" checked />
                </div>
            </div>
        </section>

        <!-- 4. ORG ADMIN: USERS & PERMISSIONS -->
        <section class="settings-section" id="section-users">
            <div class="settings-page-title">
                <div>
                    <h2>Users &amp; Permissions</h2>
                    <p>Manage accountant and user accounts and their permitted organizational units.</p>
                </div>
                <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" onclick="openStaffModal()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                    <span>+ Add Staff Account</span>
                </button>
            </div>

            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Organization Staff</h3>
                        <p>Accountants and staff users with access to your organization's units.</p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table settings-table align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="staffRows">
                            <tr><td colspan="5" class="text-center py-4 text-muted">Loading staff accounts...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 5. ORG ADMIN: NOTIFICATION SETTINGS -->
        <section class="settings-section" id="section-notifications">
            <div class="settings-page-title">
                <div>
                    <h2>Notification Settings</h2>
                    <p>Configure operational and financial alerts for your organization.</p>
                </div>
                <button type="button" class="btn btn-primary" id="saveNotificationsBtn">Save Notification Settings</button>
            </div>

            <div class="settings-card">
                <div class="settings-card-heading">
                    <div>
                        <h3>Financial Alerts</h3>
                        <p>Receive notifications for important ledger events and milestones.</p>
                    </div>
                </div>

                <div class="settings-toggle-row">
                    <div>
                        <strong>Overdue Bills Alert</strong>
                        <p>Receive notifications when outstanding vendor bills exceed their due dates.</p>
                    </div>
                    <input type="checkbox" id="notifyOverdueBills" checked />
                </div>

                <div class="settings-toggle-row">
                    <div>
                        <strong>High Expense Alert</strong>
                        <p>Alert when an individual expense entry exceeds Rs. 50,000.</p>
                    </div>
                    <input type="checkbox" id="notifyHighExpense" checked />
                </div>

                <div class="settings-toggle-row">
                    <div>
                        <strong>Deletion Request Alerts</strong>
                        <p>Notify administrators when accountants or staff submit deletion requests.</p>
                    </div>
                    <input type="checkbox" id="notifyDeletionRequests" checked />
                </div>

                <div class="settings-toggle-row">
                    <div>
                        <strong>Daily Financial Summary</strong>
                        <p>Show cash flow performance summary and quick totals on the dashboard.</p>
                    </div>
                    <input type="checkbox" id="notifyDailySummary" checked />
                </div>
            </div>
        </section>

    </main>
</div>

<!-- MODAL: ADD STAFF ACCOUNT (ORG ADMIN) -->
<div class="modal fade" id="settingsStaffModal" tabindex="-1" aria-labelledby="settingsStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:14px;">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark" id="settingsStaffModalLabel">Add Staff Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="settingsStaffForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="staffRoleSelect" class="form-label small fw-semibold text-dark">Account Role *</label>
                        <select id="staffRoleSelect" class="form-select" required>
                            <option value="Accountant">Accountant (can post transactions &amp; bills)</option>
                            <option value="User">User (view-only ledger access)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="staffFullName" class="form-label small fw-semibold text-dark">Full Name *</label>
                        <input type="text" id="staffFullName" class="form-control" placeholder="e.g. Ayesha Khan" required />
                    </div>
                    <div class="mb-3">
                        <label for="staffEmail" class="form-label small fw-semibold text-dark">Email Address *</label>
                        <input type="email" id="staffEmail" class="form-control" placeholder="staff@organization.com" required />
                    </div>
                    <div class="mb-3">
                        <label for="staffPassword" class="form-label small fw-semibold text-dark">Password</label>
                        <input type="password" id="staffPassword" class="form-control" placeholder="Leave blank to default to Demo@123" />
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="saveStaffBtn">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const settingsFeedback = document.getElementById("settingsFeedback");

    // Nav Switcher
    const navItems = document.querySelectorAll(".settings-nav-item");
    const sections = document.querySelectorAll(".settings-section");

    navItems.forEach(btn => {
        btn.addEventListener("click", () => {
            const sec = btn.dataset.section;
            if (!sec) return;

            navItems.forEach(n => n.classList.remove("active"));
            sections.forEach(s => s.classList.remove("active"));

            btn.classList.add("active");
            const target = document.getElementById("section-" + sec);
            if (target) target.classList.add("active");

            if (settingsFeedback) settingsFeedback.style.display = "none";
        });
    });

    function showFeedback(msg, isError = false) {
        if (!settingsFeedback) return;
        settingsFeedback.textContent = msg;
        settingsFeedback.className = isError
            ? "settings-alert alert alert-danger"
            : "settings-alert alert alert-success";
        settingsFeedback.style.display = "block";
        setTimeout(() => { settingsFeedback.style.display = "none"; }, 5000);
    }

    function escapeHtml(str) {
        return String(str || "").replace(/[&<>"']/g, c => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
        })[c]);
    }

    let categoryData = { revenue: [], expense: [], bill: [] };

    const staffModalEl = document.getElementById("settingsStaffModal");
    const staffModal = staffModalEl ? new bootstrap.Modal(staffModalEl) : null;

    window.openStaffModal = function() {
        document.getElementById("staffFullName").value = "";
        document.getElementById("staffEmail").value = "";
        document.getElementById("staffPassword").value = "";
        staffModal?.show();
    };

    async function loadOrgAdminData() {
        try {
            const [settingsRes, usersRes] = await Promise.all([
                fetch("/api/settings/data"),
                fetch("/api/users/data")
            ]);

            if (settingsRes.ok) {
                const data = await settingsRes.json();
                const settings = data.settings || {};

                if (document.getElementById("orgName")) document.getElementById("orgName").value = data.organizationName || settings.OrganizationName || "";
                if (document.getElementById("orgEmail")) document.getElementById("orgEmail").value = settings.OfficialEmail || "";
                if (document.getElementById("orgPhone")) document.getElementById("orgPhone").value = settings.ContactNumber || "";
                if (document.getElementById("orgAddress")) document.getElementById("orgAddress").value = settings.Address || "";
                if (document.getElementById("orgTimezone")) document.getElementById("orgTimezone").value = settings.Timezone || "Asia/Karachi";
                if (document.getElementById("currency")) document.getElementById("currency").value = settings.Currency || "PKR";
                if (document.getElementById("dateFormat")) document.getElementById("dateFormat").value = settings.DateFormat || "DD/MM/YYYY";
                if (document.getElementById("decimalPlaces")) document.getElementById("decimalPlaces").value = settings.DecimalPlaces || "0";
                if (document.getElementById("defaultPayment")) document.getElementById("defaultPayment").value = settings.DefaultPayment || "Cash";

                if (document.getElementById("requireDescription")) document.getElementById("requireDescription").checked = settings.RequireDescription !== "false";
                if (document.getElementById("enableAudit")) document.getElementById("enableAudit").checked = settings.EnableAudit !== "false";
                if (document.getElementById("allowPartialPayments")) document.getElementById("allowPartialPayments").checked = settings.AllowPartialPayments !== "false";

                if (document.getElementById("notifyOverdueBills")) document.getElementById("notifyOverdueBills").checked = settings.NotifyOverdueBills !== "false";
                if (document.getElementById("notifyHighExpense")) document.getElementById("notifyHighExpense").checked = settings.NotifyHighExpense !== "false";
                if (document.getElementById("notifyDeletionRequests")) document.getElementById("notifyDeletionRequests").checked = settings.NotifyDeletionRequests !== "false";
                if (document.getElementById("notifyDailySummary")) document.getElementById("notifyDailySummary").checked = settings.NotifyDailySummary !== "false";

                const cats = data.categories || [];
                categoryData.revenue = cats.filter(c => c.type === "revenue");
                categoryData.expense = cats.filter(c => c.type === "expense");
                categoryData.bill = cats.filter(c => c.type === "bill");

                ["revenue", "expense", "bill"].forEach(renderCategoryTable);
            }

            if (usersRes.ok) {
                const userData = await usersRes.json();
                const staffUsers = userData.users || userData.admins || [];
                const staffTbody = document.getElementById("staffRows");
                if (staffTbody) {
                    if (staffUsers.length === 0) {
                        staffTbody.innerHTML = `<tr><td colspan="5" class="settings-empty">No staff accounts registered. Add accountants or users above.</td></tr>`;
                    } else {
                        staffTbody.innerHTML = staffUsers.map(u => `
                            <tr>
                                <td><strong>${escapeHtml(u.name)}</strong></td>
                                <td>${escapeHtml(u.email)}</td>
                                <td><span class="badge bg-light text-dark border">${escapeHtml(u.role)}</span></td>
                                <td>
                                    <span class="badge ${u.active ? "bg-success" : "bg-secondary"}">
                                        ${u.active ? "Active" : "Inactive"}
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="toggleUser(${u.id})">
                                        ${u.active ? "Deactivate" : "Activate"}
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteUser(${u.id}, '${escapeHtml(u.name)}')">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        `).join("");
                    }
                }
            }
        } catch (err) {
            console.error("Org Admin Data Load Error:", err);
            showFeedback("Failed to load organization settings.", true);
        }
    }

    function renderCategoryTable(type) {
        const tbody = document.getElementById(type + "CategoryRows");
        if (!tbody) return;
        const categories = categoryData[type] || [];

        if (!categories.length) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="3" class="settings-empty">
                        No ${type} categories added yet. Add a category above.
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = categories.map((cat) => `
            <tr>
                <td><strong>${escapeHtml(cat.name)}</strong></td>
                <td>
                    <span class="badge ${cat.active ? "bg-success" : "bg-secondary"}">
                        ${cat.active ? "Active" : "Inactive"}
                    </span>
                </td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="editCategory('${type}', ${cat.id}, '${escapeHtml(cat.name)}')">
                        Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="toggleCategory('${type}', ${cat.id})">
                        ${cat.active ? "Deactivate" : "Activate"}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteCategory('${type}', ${cat.id}, '${escapeHtml(cat.name)}')">
                        Delete
                    </button>
                </td>
            </tr>
        `).join("");
    }

    window.addCategory = async function(type, inputId) {
        const input = document.getElementById(inputId);
        const name = input?.value.trim();
        if (!name) return;

        try {
            const res = await fetch("/api/settings/category/add", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: name, type: type })
            });
            const result = await res.json();
            if (result.success) {
                input.value = "";
                showFeedback(`Category "${name}" added successfully.`);
                await loadOrgAdminData();
            } else {
                alert(result.message || "Failed to add category.");
            }
        } catch (err) {
            alert("Error adding category.");
        }
    };

    window.editCategory = async function(type, id, oldName) {
        const newName = prompt(`Enter new name for category "${oldName}":`, oldName);
        if (!newName || !newName.trim() || newName.trim() === oldName) return;

        try {
            const res = await fetch("/api/settings/category/edit", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: Number(id), name: newName.trim() })
            });
            const result = await res.json();
            if (result.success) {
                showFeedback(result.message || "Category updated.");
                await loadOrgAdminData();
            } else {
                alert(result.message || "Failed to update category.");
            }
        } catch (err) {
            alert("Error updating category.");
        }
    };

    window.toggleCategory = async function(type, id) {
        try {
            const res = await fetch("/api/settings/category/toggle", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: Number(id) })
            });
            const result = await res.json();
            if (result.success) {
                await loadOrgAdminData();
            } else {
                alert(result.message || "Failed to toggle category.");
            }
        } catch (err) {
            alert("Error updating category status.");
        }
    };

    window.deleteCategory = async function(type, id, name) {
        if (!confirm(`Are you sure you want to delete category "${name}"? Categories in active financial records cannot be removed.`)) return;

        try {
            const res = await fetch("/api/settings/category/delete", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: Number(id) })
            });
            const result = await res.json();
            if (result.success) {
                showFeedback(result.message || "Category deleted.");
                await loadOrgAdminData();
            } else {
                alert(result.message || "Failed to delete category.");
            }
        } catch (err) {
            alert("Error deleting category.");
        }
    };

    window.toggleUser = async function(id) {
        try {
            const res = await fetch("/api/users/toggle", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: id })
            });
            const result = await res.json();
            if (result.success) {
                await loadOrgAdminData();
            } else {
                alert(result.message || "Failed to update user status.");
            }
        } catch (err) {
            alert("Network error while updating user.");
        }
    };

    window.deleteUser = async function(id, name) {
        if (!confirm(`Are you sure you want to delete user account "${name}"?`)) return;

        try {
            const res = await fetch("/api/users/delete", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: id })
            });
            const result = await res.json();
            if (result.success) {
                showFeedback(`Account "${name}" deleted.`);
                await loadOrgAdminData();
            } else {
                alert(result.message || "Failed to delete account.");
            }
        } catch (err) {
            alert("Network error while deleting account.");
        }
    };

    // Category Forms
    const revForm = document.getElementById("revenueCategoryForm");
    if (revForm) revForm.addEventListener("submit", (e) => { e.preventDefault(); addCategory("revenue", "revenueCategoryName"); });

    const expForm = document.getElementById("expenseCategoryForm");
    if (expForm) expForm.addEventListener("submit", (e) => { e.preventDefault(); addCategory("expense", "expenseCategoryName"); });

    const billForm = document.getElementById("billCategoryForm");
    if (billForm) billForm.addEventListener("submit", (e) => { e.preventDefault(); addCategory("bill", "billCategoryName"); });

    // Save Profile
    const saveProfileBtn = document.getElementById("saveProfileBtn");
    if (saveProfileBtn) {
        saveProfileBtn.addEventListener("click", async () => {
            saveProfileBtn.disabled = true;
            const payload = {
                OrganizationName: document.getElementById("orgName")?.value.trim() ?? "",
                OfficialEmail: document.getElementById("orgEmail")?.value.trim() ?? "",
                ContactNumber: document.getElementById("orgPhone")?.value.trim() ?? "",
                Address: document.getElementById("orgAddress")?.value.trim() ?? "",
                Timezone: document.getElementById("orgTimezone")?.value ?? "Asia/Karachi"
            };
            try {
                const res = await fetch("/api/settings/save", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) showFeedback("Organization profile saved successfully.");
                else alert(result.message || "Failed to save profile.");
            } catch (err) {
                alert("Network error while saving profile.");
            } finally {
                saveProfileBtn.disabled = false;
            }
        });
    }

    // Save Preferences
    const savePreferencesBtn = document.getElementById("savePreferencesBtn");
    if (savePreferencesBtn) {
        savePreferencesBtn.addEventListener("click", async () => {
            savePreferencesBtn.disabled = true;
            const payload = {
                Currency: document.getElementById("currency")?.value ?? "PKR",
                DateFormat: document.getElementById("dateFormat")?.value ?? "DD/MM/YYYY",
                DecimalPlaces: document.getElementById("decimalPlaces")?.value ?? "0",
                DefaultPayment: document.getElementById("defaultPayment")?.value ?? "Cash",
                RequireDescription: document.getElementById("requireDescription")?.checked ? "true" : "false",
                EnableAudit: document.getElementById("enableAudit")?.checked ? "true" : "false",
                AllowPartialPayments: document.getElementById("allowPartialPayments")?.checked ? "true" : "false"
            };
            try {
                const res = await fetch("/api/settings/save", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) showFeedback("Financial preferences saved successfully.");
                else alert(result.message || "Failed to save preferences.");
            } catch (err) {
                alert("Network error while saving preferences.");
            } finally {
                savePreferencesBtn.disabled = false;
            }
        });
    }

    // Save Notifications
    const saveNotificationsBtn = document.getElementById("saveNotificationsBtn");
    if (saveNotificationsBtn) {
        saveNotificationsBtn.addEventListener("click", async () => {
            saveNotificationsBtn.disabled = true;
            const payload = {
                NotifyOverdueBills: document.getElementById("notifyOverdueBills")?.checked ? "true" : "false",
                NotifyHighExpense: document.getElementById("notifyHighExpense")?.checked ? "true" : "false",
                NotifyDeletionRequests: document.getElementById("notifyDeletionRequests")?.checked ? "true" : "false",
                NotifyDailySummary: document.getElementById("notifyDailySummary")?.checked ? "true" : "false"
            };
            try {
                const res = await fetch("/api/settings/save", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) showFeedback("Notification preferences saved successfully.");
                else alert(result.message || "Failed to save notification settings.");
            } catch (err) {
                alert("Network error while saving notifications.");
            } finally {
                saveNotificationsBtn.disabled = false;
            }
        });
    }

    // Create Staff Form Submission
    const staffForm = document.getElementById("settingsStaffForm");
    if (staffForm) {
        staffForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = document.getElementById("saveStaffBtn");
            btn.disabled = true;

            const role = document.getElementById("staffRoleSelect").value;
            const name = document.getElementById("staffFullName").value.trim();
            const email = document.getElementById("staffEmail").value.trim();
            const password = document.getElementById("staffPassword").value.trim();

            try {
                const res = await fetch("/api/users/admins", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        name: name,
                        email: email,
                        password: password || "Demo@123",
                        role: role
                    })
                });
                const result = await res.json();
                if (result.success) {
                    staffModal?.hide();
                    showFeedback(`Account "${name}" created successfully.`);
                    await loadOrgAdminData();
                } else {
                    alert(result.message || "Failed to create account.");
                }
            } catch (err) {
                alert("Network error while creating account.");
            } finally {
                btn.disabled = false;
            }
        });
    }

    loadOrgAdminData();
})();
</script>
}
@using Microsoft.AspNetCore.Http

@{
    var userRole = Context.Session.GetString("UserRole") ?? "";
    var isSuperAdmin = userRole == "Super Admin";
    ViewData["Title"] = isSuperAdmin ? "Manage Organizations & Admins" : "Manage Users";
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pb-2 border-bottom">
        <div>
            <h1 class="h4 mb-1 text-dark fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted small mb-0">
                @(isSuperAdmin
                    ? "Manage organizations and assign organization admins."
                    : "Manage accountant and user accounts for your organization.")
            </p>
        </div>
        <div class="d-flex gap-2" id="headerActionButtons">
            @if (isSuperAdmin)
            {
                <button type="button" class="btn btn-outline-primary btn-sm px-3 d-inline-flex align-items-center gap-1" id="btnNewOrg">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>New Organization</span>
                </button>
                <button type="button" class="btn btn-primary btn-sm px-3 d-inline-flex align-items-center gap-1" id="btnNewAdmin">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                    <span>Add Organization Admin</span>
                </button>
            }
            else
            {
                <button type="button" class="btn btn-primary btn-sm px-3 d-inline-flex align-items-center gap-1" id="btnNewUser">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Add User</span>
                </button>
            }
        </div>
    </div>

    <!-- Alert Banner -->
    <div id="usersAlert" class="alert alert-success alert-dismissible fade show border-0 shadow-sm" style="display:none;border-radius:10px;" role="alert">
        <span id="usersAlertText"></span>
        <button type="button" class="btn-close" aria-label="Close" onclick="document.getElementById('usersAlert').style.display='none'"></button>
    </div>

    @if (isSuperAdmin)
    {
        <!-- Navigation Tabs for Super Admin (2 Tabs Only) -->
        <ul class="nav nav-tabs border-bottom" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold text-dark" id="tab-orgs-btn" data-bs-toggle="tab" data-bs-target="#tab-orgs" type="button" role="tab" style="font-size:13px;">
                    Organizations (<span id="badgeOrgCount">0</span>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold text-dark" id="tab-admins-btn" data-bs-toggle="tab" data-bs-target="#tab-admins" type="button" role="tab" style="font-size:13px;">
                    Organization Admins (<span id="badgeAdminCount">0</span>)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="adminTabContent">
            <!-- TAB 1: ORGANIZATIONS -->
            <div class="tab-pane fade show active" id="tab-orgs" role="tabpanel">
                <div class="card border-0 shadow-sm mt-3" style="border-radius:12px;">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="card-title mb-0 fw-bold text-dark">Organizations</h6>
                            <small class="text-muted">Registered organizations and their operational units</small>
                        </div>
                        <input type="text" id="orgSearchInput" class="form-control form-control-sm" placeholder="Search organization or unit..." style="width:240px;border-radius:8px;" />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-3">Organization</th>
                                    <th>Units Structure</th>
                                    <th>Assigned Admin</th>
                                    <th>Admin Email</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="orgsTableBody">
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Loading organizations...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 2: ORGANIZATION ADMINS -->
            <div class="tab-pane fade" id="tab-admins" role="tabpanel">
                <div class="card border-0 shadow-sm mt-3" style="border-radius:12px;">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="card-title mb-0 fw-bold text-dark">Organization Admins</h6>
                            <small class="text-muted">Administrators assigned to organizations</small>
                        </div>
                        <input type="text" id="adminSearchInput" class="form-control form-control-sm" placeholder="Search admin name, email or org..." style="width:260px;border-radius:8px;" />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-3">Admin</th>
                                    <th>Assigned Organization</th>
                                    <th>Permitted Units</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="adminsTableBody">
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Loading organization admins...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ORGANIZATION ADMIN VIEW -->
        <div class="card border-0 shadow-sm" style="border-radius:12px;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h6 class="card-title mb-0 fw-bold text-dark">Organization Users</h6>
                    <small class="text-muted">Manage accountants and staff users for your organization</small>
                </div>
                <div class="d-flex gap-2">
                    <input type="text" id="userSearchInput" class="form-control form-control-sm" placeholder="Search by name or email..." style="width:220px;border-radius:8px;" />
                    <select id="userRoleFilter" class="form-select form-select-sm" style="width:150px;border-radius:8px;">
                        <option value="all">All Roles</option>
                        <option value="Accountant">Accountant</option>
                        <option value="User">User</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">Name &amp; Email</th>
                            <th>Role</th>
                            <th>Permitted Units</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Loading users...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- MODAL: ADD / EDIT ORGANIZATION (SUPER ADMIN) -->
<div class="modal fade" id="orgModal" tabindex="-1" aria-labelledby="orgModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:16px;">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark" id="orgModalLabel">Add Organization</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="orgForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="editOrgId" value="" />
                    <div class="mb-3">
                        <label for="orgNameInput" class="form-label small fw-semibold text-dark">Organization Name *</label>
                        <input type="text" id="orgNameInput" class="form-control" placeholder="e.g., Edutech Solutions" required />
                    </div>
                    <div class="mb-3">
                        <label for="orgUnitsInput" class="form-label small fw-semibold text-dark">Organizational Units (one per line) *</label>
                        <textarea id="orgUnitsInput" class="form-control" rows="5" placeholder="School&#10;College&#10;BS Program&#10;Training Center&#10;Evening Academy" required></textarea>
                        <small class="text-muted d-block mt-1">Specify operational divisions under this organization.</small>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="saveOrgBtn">Save Organization</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: DELETE ORGANIZATION (SUPER ADMIN) -->
<div class="modal fade" id="deleteOrgModal" tabindex="-1" aria-labelledby="deleteOrgModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:16px;">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-danger" id="deleteOrgModalLabel">Delete Organization</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="deleteOrgId" value="" />
                <p class="mb-3">Are you sure you want to delete organization <strong id="deleteOrgName" class="text-dark"></strong>?</p>
                <div class="alert alert-warning small border-0 mb-0 d-flex gap-2 align-items-start" style="border-radius:10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 text-warning mt-1"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <div>
                        <strong>Notice:</strong> Associated operational units and configurations will be removed. To prevent data corruption, organizations with recorded transactions, bills, or assigned user accounts cannot be deleted.
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top py-2 px-4">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm px-4" id="confirmDeleteOrgBtn">Confirm Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: ADD / EDIT ORGANIZATION ADMIN (SUPER ADMIN) -->
<div class="modal fade" id="adminModal" tabindex="-1" aria-labelledby="adminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius:16px;">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark" id="adminModalLabel">Add Organization Admin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="adminForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="editAdminId" value="" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="adminOrgSelect" class="form-label small fw-semibold text-dark">Assigned Organization *</label>
                            <select id="adminOrgSelect" class="form-select" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">System Role</label>
                            <input type="text" class="form-control bg-light" value="Organization Admin" readonly />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="adminNameInput" class="form-label small fw-semibold text-dark">Full Name *</label>
                            <input type="text" id="adminNameInput" class="form-control" placeholder="e.g., Tariq Mehmood" required />
                        </div>
                        <div class="col-md-6">
                            <label for="adminEmailInput" class="form-label small fw-semibold text-dark">Email Address *</label>
                            <input type="email" id="adminEmailInput" class="form-control" placeholder="admin@organization.com" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="adminPasswordInput" class="form-label small fw-semibold text-dark">Password</label>
                        <input type="password" id="adminPasswordInput" class="form-control" placeholder="Leave blank to default to Demo@123" />
                        <small class="text-muted d-block mt-1">When editing, leave blank to retain the current password.</small>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark">Permitted Organizational Units *</label>
                        <p class="text-muted small mb-2">Select one or multiple organizational units this admin has authority over.</p>
                        <div id="adminUnitCheckboxesContainer" class="d-flex flex-wrap gap-2 p-3 bg-light rounded border">
                            <span class="text-muted small">Select an organization first to load its units.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="saveAdminBtn">Save Admin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ADD / EDIT ACCOUNTANT OR USER (ORGANIZATION ADMIN) -->
<div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius:16px;">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark" id="userModalLabel">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="userForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="editUserId" value="" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="userRoleSelect" class="form-label small fw-semibold text-dark">Role *</label>
                            <select id="userRoleSelect" class="form-select" required>
                                <option value="Accountant">Accountant</option>
                                <option value="User">User</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="userNameInput" class="form-label small fw-semibold text-dark">Full Name *</label>
                            <input type="text" id="userNameInput" class="form-control" placeholder="e.g. Ayesha Khan" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="userEmailInput" class="form-label small fw-semibold text-dark">Email Address *</label>
                            <input type="email" id="userEmailInput" class="form-control" placeholder="user@organization.com" required />
                        </div>
                        <div class="col-md-6">
                            <label for="userPasswordInput" class="form-label small fw-semibold text-dark">Password</label>
                            <input type="password" id="userPasswordInput" class="form-control" placeholder="Leave blank to default to Demo@123" />
                            <small class="text-muted d-block mt-1">When editing, leave blank to retain password.</small>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark">Permitted Organizational Units *</label>
                        <p class="text-muted small mb-2">Select one or multiple organizational units permitted for this account.</p>
                        <div id="userUnitCheckboxesContainer" class="d-flex flex-wrap gap-2 p-3 bg-light rounded border">
                            <span class="text-muted small">Loading units...</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="saveUserBtn">Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const isSuperAdmin = @(isSuperAdmin ? "true" : "false");

    let institutes = [];
    let admins = [];
    let allUnits = [];

    const orgModalEl = document.getElementById('orgModal');
    const deleteOrgModalEl = document.getElementById('deleteOrgModal');
    const adminModalEl = document.getElementById('adminModal');
    const userModalEl = document.getElementById('userModal');

    const orgModal = orgModalEl ? new bootstrap.Modal(orgModalEl) : null;
    const deleteOrgModal = deleteOrgModalEl ? new bootstrap.Modal(deleteOrgModalEl) : null;
    const adminModal = adminModalEl ? new bootstrap.Modal(adminModalEl) : null;
    const userModal = userModalEl ? new bootstrap.Modal(userModalEl) : null;

    function safe(str) {
        return String(str || '').replace(/[&<>"']/g, c => ({
            '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
        })[c]);
    }

    function showAlert(msg, isError = false) {
        const box = document.getElementById('usersAlert');
        const txt = document.getElementById('usersAlertText');
        if (!box || !txt) return;
        txt.textContent = msg;
        box.className = isError
            ? 'alert alert-danger alert-dismissible fade show border-0 shadow-sm'
            : 'alert alert-success alert-dismissible fade show border-0 shadow-sm';
        box.style.display = 'block';
        setTimeout(() => { box.style.display = 'none'; }, 4000);
    }

    function parseUnits(json) {
        if (!json) return [];
        try {
            const arr = JSON.parse(json);
            if (Array.isArray(arr)) return arr;
        } catch {}
        return [];
    }

    async function loadData() {
        try {
            const res = await fetch('/api/users/data');
            if (!res.ok) throw new Error('Failed to fetch data');
            const data = await res.json();

            institutes = data.institutes || [];
            admins = data.admins || [];
            allUnits = data.allUnits || [];

            if (isSuperAdmin) {
                const orgCountElem = document.getElementById('badgeOrgCount');
                if (orgCountElem) orgCountElem.textContent = institutes.length;

                const adminCountElem = document.getElementById('badgeAdminCount');
                if (adminCountElem) adminCountElem.textContent = admins.length;

                renderOrgs();
                renderAdmins();
                populateAdminOrgSelect();
            } else {
                renderUsers();
                renderUserUnitCheckboxes();
            }
        } catch (e) {
            console.error(e);
        }
    }

    // --- SUPER ADMIN: RENDER ORGANIZATIONS ---
    function renderOrgs() {
        const tbody = document.getElementById('orgsTableBody');
        if (!tbody) return;

        const q = (document.getElementById('orgSearchInput')?.value || '').trim().toLowerCase();
        const filtered = institutes.filter(i =>
            i.name.toLowerCase().includes(q) ||
            (i.units || []).some(u => u.name.toLowerCase().includes(q))
        );

        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No organizations match the search criteria.</td></tr>';
            return;
        }

        tbody.innerHTML = filtered.map(org => {
            const unitBadges = (org.units && org.units.length > 0)
                ? org.units.map(u => `<span class="badge bg-light text-dark border me-1 mb-1">${safe(u.name)}</span>`).join('')
                : '<span class="text-muted small">No units</span>';

            return `
                <tr>
                    <td class="ps-3">
                        <div class="fw-bold text-dark">${safe(org.name)}</div>
                        <small class="text-muted">ID: ${org.id}</small>
                    </td>
                    <td style="max-width:320px;">${unitBadges}</td>
                    <td>
                        <div class="fw-semibold text-dark small">${safe(org.ownerName)}</div>
                    </td>
                    <td>
                        <small class="text-muted">${safe(org.ownerEmail)}</small>
                    </td>
                    <td class="text-end pe-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:12px;" onclick="editOrg(${org.id})">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 ms-1" style="font-size:12px;" onclick="assignAdminForOrg(${org.id})">Manage Admin</button>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 ms-1" style="font-size:12px;" onclick="openDeleteOrgModal(${org.id})">Delete</button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    // --- SUPER ADMIN: RENDER ORGANIZATION ADMINS ---
    function renderAdmins() {
        const tbody = document.getElementById('adminsTableBody');
        if (!tbody) return;

        const q = (document.getElementById('adminSearchInput')?.value || '').trim().toLowerCase();
        const filtered = admins.filter(u =>
            u.name.toLowerCase().includes(q) ||
            u.email.toLowerCase().includes(q) ||
            u.instituteName.toLowerCase().includes(q)
        );

        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No organization admins found.</td></tr>';
            return;
        }

        tbody.innerHTML = filtered.map(admin => {
            const units = parseUnits(admin.assignedUnits);
            const unitBadges = units.length
                ? units.map(un => `<span class="badge bg-light text-dark border me-1">${safe(un)}</span>`).join('')
                : '<span class="text-muted small">All Units</span>';

            return `
                <tr>
                    <td class="ps-3">
                        <div class="fw-bold text-dark">${safe(admin.name)}</div>
                        <small class="text-muted">${safe(admin.email)}</small>
                    </td>
                    <td>
                        <span class="fw-semibold text-dark">${safe(admin.instituteName)}</span>
                    </td>
                    <td style="max-width:260px;">${unitBadges}</td>
                    <td>
                        <span class="badge ${admin.active ? 'bg-success-subtle text-success' : 'bg-light text-secondary border'}">
                            ${admin.active ? 'Active' : 'Disabled'}
                        </span>
                    </td>
                    <td class="text-end pe-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:12px;" onclick="editAdmin(${admin.id})">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 ms-1" style="font-size:12px;" onclick="toggleUser(${admin.id})">
                            ${admin.active ? 'Disable' : 'Enable'}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 ms-1" style="font-size:12px;" onclick="deleteUser(${admin.id}, '${safe(admin.name)}')">Delete</button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    // --- ORGANIZATION ADMIN: RENDER USERS (ACCOUNTANT & USER) ---
    function renderUsers() {
        const tbody = document.getElementById('usersTableBody');
        if (!tbody) return;

        const q = (document.getElementById('userSearchInput')?.value || '').trim().toLowerCase();
        const roleF = document.getElementById('userRoleFilter')?.value || 'all';

        const filtered = admins.filter(u => {
            const matchQ = u.name.toLowerCase().includes(q) || u.email.toLowerCase().includes(q);
            const matchRole = (roleF === 'all' || u.role === roleF);
            return matchQ && matchRole;
        });

        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No accounts match the filters.</td></tr>';
            return;
        }

        tbody.innerHTML = filtered.map(u => {
            const units = parseUnits(u.assignedUnits);
            const unitBadges = units.length
                ? units.map(un => `<span class="badge bg-light text-dark border me-1">${safe(un)}</span>`).join('')
                : '<span class="text-muted small">None</span>';

            const roleBadgeClass = u.role === 'Accountant' ? 'bg-primary-subtle text-primary border' : 'bg-secondary-subtle text-secondary border';

            return `
                <tr>
                    <td class="ps-3">
                        <div class="fw-bold text-dark">${safe(u.name)}</div>
                        <small class="text-muted">${safe(u.email)}</small>
                    </td>
                    <td><span class="badge ${roleBadgeClass}">${safe(u.role)}</span></td>
                    <td style="max-width:260px;">${unitBadges}</td>
                    <td>
                        <span class="badge ${u.active ? 'bg-success-subtle text-success' : 'bg-light text-secondary border'}">
                            ${u.active ? 'Active' : 'Disabled'}
                        </span>
                    </td>
                    <td class="text-end pe-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:12px;" onclick="editUser(${u.id})">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 ms-1" style="font-size:12px;" onclick="toggleUser(${u.id})">
                            ${u.active ? 'Disable' : 'Enable'}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 ms-1" style="font-size:12px;" onclick="deleteUser(${u.id}, '${safe(u.name)}')">Delete</button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    // --- POPULATE ORG SELECT & CHECKBOXES FOR SUPER ADMIN ---
    function populateAdminOrgSelect(selectedId = null) {
        const select = document.getElementById('adminOrgSelect');
        if (!select) return;

        select.innerHTML = institutes.map(i => `<option value="${i.id}">${safe(i.name)}</option>`).join('');
        if (selectedId) select.value = selectedId;
        renderAdminUnitCheckboxes();
    }

    function renderAdminUnitCheckboxes(selectedNames = []) {
        const container = document.getElementById('adminUnitCheckboxesContainer');
        if (!container) return;

        const select = document.getElementById('adminOrgSelect');
        const orgId = select ? Number(select.value) : (institutes[0]?.id || 1);
        const org = institutes.find(i => i.id === orgId);

        const units = (org && org.units && org.units.length > 0)
            ? org.units
            : allUnits;

        if (!units || units.length === 0) {
            container.innerHTML = '<span class="text-muted small">No organizational units registered for this organization.</span>';
            return;
        }

        container.innerHTML = units.map(u => `
            <div class="form-check form-check-inline m-0 me-3">
                <input class="form-check-input" type="checkbox" name="adminUnits" value="${safe(u.name)}" id="chk_adm_${safe(u.name)}" ${selectedNames.length === 0 || selectedNames.includes(u.name) ? 'checked' : ''} />
                <label class="form-check-label small" for="chk_adm_${safe(u.name)}">${safe(u.name)}</label>
            </div>
        `).join('');
    }

    // --- POPULATE UNIT CHECKBOXES FOR ORG ADMIN (USER MODAL) ---
    function renderUserUnitCheckboxes(selectedNames = []) {
        const container = document.getElementById('userUnitCheckboxesContainer');
        if (!container) return;

        const units = allUnits;
        if (!units || units.length === 0) {
            container.innerHTML = '<span class="text-muted small">No organizational units registered for your organization.</span>';
            return;
        }

        container.innerHTML = units.map(u => `
            <div class="form-check form-check-inline m-0 me-3">
                <input class="form-check-input" type="checkbox" name="userUnits" value="${safe(u.name)}" id="chk_usr_${safe(u.name)}" ${selectedNames.length === 0 || selectedNames.includes(u.name) ? 'checked' : ''} />
                <label class="form-check-label small" for="chk_usr_${safe(u.name)}">${safe(u.name)}</label>
            </div>
        `).join('');
    }

    // --- MODAL TRIGGERS ---
    window.openDeleteOrgModal = function(id) {
        const org = institutes.find(i => i.id === id);
        if (!org || !deleteOrgModal) return;

        document.getElementById('deleteOrgId').value = org.id;
        document.getElementById('deleteOrgName').textContent = org.name;
        deleteOrgModal.show();
    };

    window.editOrg = function(id) {
        const org = institutes.find(i => i.id === id);
        if (!org || !orgModal) return;

        document.getElementById('editOrgId').value = org.id;
        document.getElementById('orgModalLabel').textContent = 'Edit Organization';
        document.getElementById('orgNameInput').value = org.name;
        document.getElementById('orgUnitsInput').value = (org.units || []).map(u => u.name).join('\n');
        orgModal.show();
    };

    window.assignAdminForOrg = function(orgId) {
        if (!adminModal) return;
        document.getElementById('editAdminId').value = '';
        document.getElementById('adminModalLabel').textContent = 'Assign Organization Admin';
        document.getElementById('adminNameInput').value = '';
        document.getElementById('adminEmailInput').value = '';
        document.getElementById('adminPasswordInput').value = '';

        populateAdminOrgSelect(orgId);
        const org = institutes.find(i => i.id === orgId);
        const orgUnits = (org?.units || []).map(u => u.name);
        renderAdminUnitCheckboxes(orgUnits);

        adminModal.show();
    };

    window.editAdmin = function(id) {
        const admin = admins.find(u => u.id === id);
        if (!admin || !adminModal) return;

        document.getElementById('editAdminId').value = admin.id;
        document.getElementById('adminModalLabel').textContent = 'Edit Organization Admin';
        document.getElementById('adminNameInput').value = admin.name;
        document.getElementById('adminEmailInput').value = admin.email;
        document.getElementById('adminPasswordInput').value = '';

        populateAdminOrgSelect(admin.instituteId);
        const assigned = parseUnits(admin.assignedUnits);
        renderAdminUnitCheckboxes(assigned);

        adminModal.show();
    };

    window.editUser = function(id) {
        const user = admins.find(u => u.id === id);
        if (!user || !userModal) return;

        document.getElementById('editUserId').value = user.id;
        document.getElementById('userModalLabel').textContent = 'Edit User';
        document.getElementById('userNameInput').value = user.name;
        document.getElementById('userEmailInput').value = user.email;
        document.getElementById('userPasswordInput').value = '';

        const roleSel = document.getElementById('userRoleSelect');
        if (roleSel) roleSel.value = user.role === 'User' ? 'User' : 'Accountant';

        const assigned = parseUnits(user.assignedUnits);
        renderUserUnitCheckboxes(assigned);

        userModal.show();
    };

    window.toggleUser = async function(id) {
        const user = admins.find(u => u.id === id);
        if (!user) return;
        const act = user.active ? 'disable' : 'enable';
        if (!confirm(`Are you sure you want to ${act} access for ${user.name}?`)) return;

        try {
            const res = await fetch('/api/users/admins/toggle-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await res.json();
            if (data.success) {
                showAlert(`Account access ${data.active ? 'enabled' : 'disabled'}.`);
                await loadData();
            } else {
                showAlert(data.message || 'Action failed', true);
            }
        } catch (e) {
            showAlert('Operation error', true);
        }
    };

    window.deleteUser = async function(id, name) {
        if (!confirm(`Delete account "${name}"? This action cannot be reversed.`)) return;

        try {
            const res = await fetch('/api/users/admins/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await res.json();
            if (data.success) {
                showAlert(`Account deleted.`);
                await loadData();
            } else {
                showAlert(data.message || 'Delete failed', true);
            }
        } catch (e) {
            showAlert('Delete error', true);
        }
    };

    // --- FORM SUBMISSIONS ---
    document.getElementById('orgForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editOrgId').value;
        const name = document.getElementById('orgNameInput').value.trim();
        const units = document.getElementById('orgUnitsInput').value.split('\n').map(u => u.trim()).filter(Boolean);

        if (!name || units.length === 0) {
            alert('Please provide an organization name and at least one unit.');
            return;
        }

        try {
            const url = id ? '/api/users/institutes/edit' : '/api/users/institutes';
            const payload = id ? { id: Number(id), name, units } : { name, units };
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                if (orgModal) orgModal.hide();
                showAlert(id ? 'Organization updated.' : 'Organization created.');
                await loadData();
            } else {
                alert(data.message || 'Operation failed');
            }
        } catch (err) {
            alert('Error saving organization');
        }
    });

    document.getElementById('adminForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editAdminId').value;
        const instituteId = Number(document.getElementById('adminOrgSelect')?.value || (institutes[0]?.id || 1));
        const name = document.getElementById('adminNameInput').value.trim();
        const email = document.getElementById('adminEmailInput').value.trim();
        const password = document.getElementById('adminPasswordInput').value.trim();

        const selectedUnits = Array.from(document.querySelectorAll('input[name="adminUnits"]:checked')).map(cb => cb.value);

        if (!name || !email) {
            alert('Name and email are required.');
            return;
        }
        if (selectedUnits.length === 0) {
            alert('Please assign at least one organizational unit.');
            return;
        }

        try {
            const url = id ? '/api/users/admins/edit' : '/api/users/admins';
            const payload = id
                ? { id: Number(id), instituteId, role: 'Organization Admin', name, email, password: password || null, units: selectedUnits }
                : { instituteId, role: 'Organization Admin', name, email, password: password || 'Demo@123', units: selectedUnits };

            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                if (adminModal) adminModal.hide();
                showAlert(id ? 'Organization Admin updated.' : 'Organization Admin created.');
                await loadData();
            } else {
                alert(data.message || 'Failed to save admin account.');
            }
        } catch (err) {
            alert('Error saving admin account.');
        }
    });

    document.getElementById('userForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editUserId').value;
        const role = document.getElementById('userRoleSelect').value;
        const name = document.getElementById('userNameInput').value.trim();
        const email = document.getElementById('userEmailInput').value.trim();
        const password = document.getElementById('userPasswordInput').value.trim();

        const selectedUnits = Array.from(document.querySelectorAll('input[name="userUnits"]:checked')).map(cb => cb.value);

        if (!name || !email) {
            alert('Name and email are required.');
            return;
        }
        if (selectedUnits.length === 0) {
            alert('Please assign at least one organizational unit.');
            return;
        }

        try {
            const url = id ? '/api/users/admins/edit' : '/api/users/admins';
            const payload = id
                ? { id: Number(id), role, name, email, password: password || null, units: selectedUnits }
                : { role, name, email, password: password || 'Demo@123', units: selectedUnits };

            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                if (userModal) userModal.hide();
                showAlert(id ? 'User account updated.' : 'User account created.');
                await loadData();
            } else {
                alert(data.message || 'Failed to save user account.');
            }
        } catch (err) {
            alert('Error saving user account.');
        }
    });

    // --- BUTTON EVENT LISTENERS ---
    document.getElementById('btnNewOrg')?.addEventListener('click', () => {
        document.getElementById('editOrgId').value = '';
        document.getElementById('orgModalLabel').textContent = 'Add Organization';
        document.getElementById('orgNameInput').value = '';
        document.getElementById('orgUnitsInput').value = 'School\nCollege\nBS Program\nTraining Center\nEvening Academy';
        if (orgModal) orgModal.show();
    });

    document.getElementById('btnNewAdmin')?.addEventListener('click', () => {
        document.getElementById('editAdminId').value = '';
        document.getElementById('adminModalLabel').textContent = 'Add Organization Admin';
        document.getElementById('adminNameInput').value = '';
        document.getElementById('adminEmailInput').value = '';
        document.getElementById('adminPasswordInput').value = '';
        populateAdminOrgSelect();
        if (adminModal) adminModal.show();
    });

    document.getElementById('btnNewUser')?.addEventListener('click', () => {
        document.getElementById('editUserId').value = '';
        document.getElementById('userModalLabel').textContent = 'Add User';
        document.getElementById('userNameInput').value = '';
        document.getElementById('userEmailInput').value = '';
        document.getElementById('userPasswordInput').value = '';
        const roleSel = document.getElementById('userRoleSelect');
        if (roleSel) roleSel.value = 'Accountant';
        renderUserUnitCheckboxes();
        if (userModal) userModal.show();
    });

    document.getElementById('orgSearchInput')?.addEventListener('input', renderOrgs);
    document.getElementById('adminSearchInput')?.addEventListener('input', renderAdmins);
    document.getElementById('userSearchInput')?.addEventListener('input', renderUsers);
    document.getElementById('userRoleFilter')?.addEventListener('change', renderUsers);
    document.getElementById('adminOrgSelect')?.addEventListener('change', () => renderAdminUnitCheckboxes());

    document.getElementById('confirmDeleteOrgBtn')?.addEventListener('click', async () => {
        const id = document.getElementById('deleteOrgId').value;
        if (!id) return;

        const btn = document.getElementById('confirmDeleteOrgBtn');
        btn.disabled = true;
        btn.textContent = 'Deleting...';

        try {
            const res = await fetch('/api/users/institutes/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: Number(id) })
            });
            const data = await res.json();
            if (deleteOrgModal) deleteOrgModal.hide();

            if (res.ok && data.success) {
                showAlert(data.message || 'Organization deleted successfully.');
                await loadData();
            } else {
                showAlert(data.message || 'Failed to delete organization.', true);
            }
        } catch (err) {
            if (deleteOrgModal) deleteOrgModal.hide();
            showAlert('An error occurred while deleting the organization.', true);
        } finally {
            btn.disabled = false;
            btn.textContent = 'Confirm Delete';
        }
    });

    // Switch tab on URL param
    const urlParams = new URLSearchParams(window.location.search);
    const tabParam = urlParams.get('tab');
    if (tabParam === 'admins' || tabParam === 'owners') {
        const tabEl = document.getElementById('tab-admins-btn');
        if (tabEl) new bootstrap.Tab(tabEl).show();
    } else if (tabParam === 'organizations') {
        const tabEl = document.getElementById('tab-orgs-btn');
        if (tabEl) new bootstrap.Tab(tabEl).show();
    }

    loadData();
})();
</script>
}
